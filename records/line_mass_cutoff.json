    {
      "id": "LMC-02",
      "chapter": "global",
      "anchor": "global-line-mass-cutoff",
      "title": "Total mass on a Hermitian line up to a discriminant cutoff",
      "hypotheses": "A fixed totally definite Hermitian line W over a degree-2f CM field unramified at finite places over its real subfield. The cutoff X is a positive integer and M₁ is the genus mass of the standard line.",
      "statement": "The sum of reciprocal automorphism orders for all line lattices of discriminant order at most X² is at most M₁ X^(2+log₂ f). For a hyperplane in the row the cutoff is X = dt.",
      "equations": [
        "global-line-mass-maximal-sum",
        "global-line-mass-total-inequality"
      ],
      "dependencies": [
        "LMC-01",
        "DML-02",
        "GPD-02"
      ],
