  "claims": [
    {
      "id": "LMC-01",
      "chapter": "global",
      "anchor": "global-line-mass-ideals",
      "title": "A sublattice in a fixed line lattice is determined by one integral ideal",
      "hypotheses": "A rank-one lattice A over the integers of a number field of degree D and a full sublattice Q. For the discriminant bound both are integral for a definite Hermitian form.",
      "statement": "Writing Q = 𝔞A gives [A∶Q] = N(𝔞). Discriminant order at most X² implies additive index at most X. At most X^(1+log₂ D) sublattices in a fixed integral A satisfy the bound.",
      "equations": [
        "global-line-mass-index-ideal"
      ],
      "dependencies": [
        "DML-01",
        "RSO-03"
      ],
