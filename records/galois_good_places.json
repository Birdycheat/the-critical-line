    {
      "id": "GGP-03",
      "chapter": "lifts",
      "anchor": "lifts-good-places-dense",
      "title": "The allowed inverse Frobenius elements meet every finite Galois restriction",
      "hypotheses": "Let Ω be an algebraic closure of the CM field E with x² = −d, let ℓ be prime and let S be any finite set of places.",
      "statement": "For every finite Galois L/E in Ω and h in Gal(L/E), an inverse Frobenius from a place of absolute degree one in Q_d outside S and away from ℓ restricts to h. The union of these lifts is dense in Gal(Ω/E).",
