    {
      "id": "GGP-01",
      "chapter": "lifts",
      "anchor": "lifts-good-places-degree-one",
      "title": "Almost every prime of absolute residue degree one passes both splitting tests",
      "hypotheses": "A CM field E contains x with x² = −d for an integer d > 0. A finite place w of residue degree one over ℚ lies over q ∤ 2d.",
      "statement": "The prime w and its complex conjugate are different, and −d is a square in ℚ_q. These two conditions define the set Q_d of allowed places. The exceptional prime divisors of 2d are finite.",
      "equations": [
        "lifts-good-places-predicate"
      ],
