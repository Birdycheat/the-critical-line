  "claims": [
    {
      "id": "EHV-01",
      "chapter": "normalization",
      "anchor": "normalization-exterior-highest-vector",
      "title": "A compact highest vector of weight μ − ρc + θ in the exterior tensor",
      "hypotheses": "The operators E_ab satisfy the compact commutation relations on a complex vector space, with coordinates ordered by decreasing μ, r positive and s negative. V is finite-dimensional, irreducible under the compact operators and has a highest-weight vector of weight L = μ + ρn − ρc for a strictly decreasing μ. S is the exterior algebra on the generators e_ia, one for each positive coordinate i and negative coordinate a, with the induced compact action.",
      "statement": "V ⊗ S contains a nonzero compact highest-weight vector of weight β = L + θ − ρn = μ − ρc + θ, where θ is s/2 on positive coordinates and −r/2 on negative ones.",
      "definitions": [
        "T0 is the set of generators e_ia with a < i; the wedge product of T0 has weight θ − ρn and is killed by every compact lowering operator.",
        "L + θ − ρn is dominant for the compact operators."
      ],
      "equations": [],
      "dependencies": [
        "EHV-02"
      ],
