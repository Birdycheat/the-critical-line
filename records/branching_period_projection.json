  "claims": [
    {
      "id": "BPP-01",
      "chapter": "normalization",
      "anchor": "normalization-branching-period-moment",
      "title": "A mixed discrete-series coefficient controls its inverse-column moment",
      "hypotheses": "The signed unitary branching pair of dimensions n+1 and n, n≥3, satisfying the interlacing, large opposing-sign gaps, weight bound B and signature conditions of TPD-01. Both lowest compact-type vectors have norm one and i is the seeded isometric intertwiner.",
      "statement": "For X=8(n+1)B and F(g)=|⟨iw₀,π(g)v₀⟩|² the column moment ∫‖g⁻¹z‖₂²F(g) dμ is at most X^(8(n+1))/dπ. The unweighted mass is exactly 1/dπ.",
      "definitions": [
        "The real dimension parameter in the exponents is the complex matrix size m=n+1. The group measures used to define dπ and dσ are the measures used in the integrals.",
        "Each shifted component costs at most X^m X^(4m) X^m/dπ in squared norm. Cauchy–Schwarz and the two finite sums use at most X³ more."
      ],
      "dependencies": [
        "STM-03",
        "BVD-02",
        "SBO-01"
      ],
