    {
      "id": "SBO-03",
      "chapter": "normalization",
      "anchor": "normalization-signed-branching-intertwiner",
      "title": "A bounded intertwiner detected by one integrated matrix coefficient",
      "hypotheses": "Strongly continuous unitary representations ρ and σ on complex Hilbert spaces, irreducible square-integrable σ with Schur orthogonality constant κ, Haar measure and a nonzero unit vector w with integrable diagonal coefficient.",
      "statement": "For each a the vector integral on an invariant dense subspace extends to a bounded intertwiner J with ⟨b,Jw⟩=I(a,b). Nonvanishing of one coefficient forces J to be nonzero.",
      "definitions": [
        "The dense subspace is the set of y for which h↦⟨σ(h)w,y⟩ is integrable.",
        "Schur orthogonality gives ‖Jy‖²=‖y‖² κ I(a,a) before the continuous extension."
      ],
      "dependencies": [],
      "equations": [
        "normalization-signed-branching-averaging-map"
      ],
