  "claims": [
    {
      "id": "SBO-01",
      "chapter": "normalization",
      "anchor": "normalization-signed-branching-walk",
      "title": "Signed occurrence by descent from a distant pair of parameters",
      "hypotheses": "G = U(p,q), 1≤q≤p, H = U(p−1,q) fixes a positive coordinate, m=p+q=n+1 and n≥2. Both Harish-Chandra parameters are regular dominant, both opposite-sign gaps are at least 200m³, and the merged word satisfies the signed interlacing rule.",
      "statement": "For every choice of the two discrete-series models there is a nonzero bounded H-intertwiner from the smaller model to the restriction of the larger one. At each lowering the opposite list avoids the half-step wall and the sum of displacements drops by one.",
      "definitions": [
        "Monotone offsets are indexed by the original numerical ordering of the two merged parameter lists.",
        "The distant λ-displacement equals t times its direction. The smaller offset is μ′−μ, where the actual occurring parameter μ′ is recovered within C√t of its predicted direction."
      ],
      "dependencies": [
        "SBO-02",
        "IBO-03",
        "SML-03"
      ],
      "equations": [
        "normalization-signed-branching-wall"
      ],
