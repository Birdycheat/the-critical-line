  "claims": [
    {
      "id": "FPR-01",
      "title": "The matrix-coefficient kernel and its orthogonal projection",
      "chapter": "lifts",
      "anchor": "lifts-fock-projection",
      "statement": "On the determinant double cover of U(p,q), let σ have formal degree d for the chosen Haar measure and v be a unit highest vector in its lowest compact type. The chain gap supplies integrability of d times the conjugate of m_v. Its integrated action P in a unitary representation is self-adjoint and satisfies Pπ(g)P=m_v(g)P. Its range is the closed span of intertwiner images of v. For a norm-one joint Fock vector η, the integral of its diagonal coefficient against the conjugate of m_v is ‖Pη‖²/d.",
      "dependencies": [],
      "equations": [
        "lifts-fock-kernel",
        "lifts-fock-square"
      ],
