  "claims": [
    {
      "id": "GGD-01",
      "chapter": "lifts",
      "title": "The rational Gram-fibre mean uses quotient Haar weights",
      "anchor": "lifts-global-gram-density",
      "statement": "The normalized average of the sum of Φ(h⁻¹X) over rational X with X*JX=T is the integral of Φ against the sum of the translated-orbit measures divided by the volume of an adelic fundamental domain.",
      "hypotheses": "CM E/F, nondegenerate rational Hermitian J of rank M, nonsingular rational Hermitian T of size n, n<M and either n+2≤M or J anisotropic. The test is a product of a Schwartz archimedean factor and pure finite Schwartz–Bruhat factors standard outside finitely many places. The fundamental domain is for rational points of the same unitary group; use a Haar measure of finite nonzero quotient volume.",
      "equations": [
        "lifts-global-gram-mean"
      ],
