    {
      "id": "DCP-01",
      "chapter": "global",
      "anchor": "global-deep-mean",
      "title": "A zero mean on a short orbit bounds a cuspidal value",
      "statement": "On a deep unipotent orbit, a vector of continuous cuspidal values with variation at most a has norm at most a at the center and at most 2a on the neighborhood.",
      "hypotheses": "The orbit has invariant probability measure, its constant term vanishes coordinatewise, and the same bound on variation holds for its representatives in the neighborhood.",
      "dependencies": [
        "UOC-02"
      ],
      "equations": [
        "global-deep-mean-zero"
      ],
