    {
      "id": "DCP-03",
      "chapter": "global",
      "anchor": "global-deep-integration",
      "title": "Cuspidal mass on the deep region",
      "statement": "Integrating the deep pointwise diagonal bound against the same Haar measure used for the quotient covolume gives ∫deep Re K(x,x) dμ ≤ D exp(−n²f).",
      "hypotheses": "The discrete-series projector has rank D. Its range is cuspidal. The pointwise and covolume estimates use the same archimedean gauge constants and finite level subgroup.",
