    {
      "id": "MGL-01",
      "chapter": "lifts",
      "anchor": "lifts-finite-markings-glued-lattice",
      "title": "Which lattice realises both finite coordinates?",
      "hypotheses": "A finite free reference lattice Λ₀ and its rational space V, a distinguished prime p, a full order-stable ℤ_(p)-lattice M in V, and an away-from-p adelic linear map T commuting with the order whose adelic left inverse is S.",
      "statement": "The intersection of M with the inverse image of the reference completed lattice is a full finite free integral lattice stable under the order. Its localization at p is M and its localization by the powers of p is precisely that inverse image.",
      "equations": [
        "lifts-finite-markings-lattice-localizations"
      ],
