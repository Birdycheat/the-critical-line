  "claims": [
    {
      "id": "STY-01",
      "chapter": "inputs",
      "title": "Split vector–covector sequences give an alternating row of stabilizations and zero maps",
      "anchor": "inputs-stable-split-sequences",
      "statement": "For G=GL_b(R) and the permutation module C_p on ordered split sequences of length p, the standard-point map identifies H_q(GL_{b−p}(R),ℤ) with H_q(G,C_p) when p+s≤b. Under adjacent identifications the differential d_p from length p+1 to p is one-step stabilization for even p and zero for odd p.",
      "hypotheses": "R commutative with stable range at most s. The first-page differential formula is stated for p+1≤b, and the two identifications are isomorphisms in the range p+1+s≤b.",
      "definitions": [
        "Split sequences satisfy λᵢ(vⱼ)=δᵢⱼ; C₀=ℤ comes from the empty ordered sequence.",
        "The standard sequence uses the last p vector–covector pairs; its point stabilizer is exactly diag(GL_{b−p}(R),I_p).",
        "A signed sum of the p+1 deletion maps has scalar ∑_{j=0}^p(−1)^j under the point maps."
      ],
      "equations": [
        "inputs-stable-face-row"
      ],
      "dependencies": [
        "SCM-01"
      ],
