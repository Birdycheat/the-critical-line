  "claims": [
    {
      "id": "SMR-01",
      "chapter": "inputs",
      "anchor": "inputs-small-modulus-progression",
      "title": "A uniform character estimate in the square-root range",
      "statement": "At log m ≤ c√log y, ψχ minus its principal term plus the simple real-zero term from the ordinary region has modulus at most Cy exp(−c√log y).",
      "hypotheses": "y≥2; m≥2; χ modulo m; fixed ordinary regional constant 0<cZ≤1/20 with cross-character uniqueness.",
      "definitions": [
        "Sχ(x)=ΣΛ(n)χ(n)(x/n−1); T=exp(cZ√log y/2); h=exp(−c₀√log y/2)."
      ],
