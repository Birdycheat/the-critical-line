    {
      "id": "ADB-02",
      "chapter": "lifts",
      "anchor": "lifts-adelic-box-packing",
      "title": "Counting with two radii in the same finite box",
      "statement": "For 0<r₀≤R the count P_N(R) of rational vectors, including zero, is at most (5R/r₀)^ν P_N(r₀) in real dimension ν=2[F:ℚ]M.",
      "hypotheses": "Both boxes use the same positive finite denominator and the same coefficient basis. The count of the small box includes the origin.",
      "correspondence": "The general theorem permits any additive coordinate map with counting measure. The chapter specializes to the rational lattice. Disjoint half-radius balls give the intermediate bound (3R/r₀)^ν for the number of centres; the published estimate of the large-ball count uses 5.",
