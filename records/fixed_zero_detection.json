  "claims": [
    {
      "id": "FZD-01",
      "chapter": "inputs",
      "anchor": "inputs-fixed-zero-detection",
      "title": "A nonprincipal zero forces a large Möbius-coefficient block",
      "statement": "For m≥3, T≥2 and a nonprincipal zero with Re ρ≥3/4 and |Im ρ|≤T, let q=⌈mT⌉, V=q³, J=8(⌊log₂q⌋+1), and N=2^J. At least one of the J blocks from V to VN has absolute value at least 1/(2J).",
      "hypotheses": "A character modulo the fixed modulus m is nonprincipal. The mollifier and the partial L-series use the same character and zero, and Y≤N.",
      "definitions": [
        "The block coefficients are the Möbius divisor sum truncated by d≤Y and n/d≤N."
      ],
