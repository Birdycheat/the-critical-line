    {
      "id": "FAR-01",
      "chapter": "global",
      "anchor": "global-far-orbits",
      "title": "Packing the rational elements in a box of Cartan radii",
      "statement": "The number of rational terms supported at the finite places with every Cartan distance bounded by Rᵥ is at most P(x) exp(2n² ΣRᵥ), with P(x)=(3√n/t²)^(2n²f) and t=min(1/2,least(x)).",
      "hypotheses": "The self-dual integral lattice and the compact finite-place stabilizer in the unitary trace construction, n ≥ 1, f ≥ 1 and nonnegative place radii.",
      "equations": [
        "global-far-box"
      ],
