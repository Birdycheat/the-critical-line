  "claims": [
    {
      "id": "SDM-01",
      "chapter": "inputs",
      "anchor": "inputs-short-detector-mean-square",
      "title": "A finite mean square for zero-dependent rows of primitive characters",
      "hypotheses": "Q≥3; a finite set S of distinct primitive characters with conductors ≤Q; 399/400<Re ρχ<1 and |Im ρχ|≤Q; integral U≥1. One point per character; no height separation required. The upstream zero detector chooses a block for Q≥20 and conductor >1.",
      "statement": "For any coefficient vector on U<n≤2U, with rows vχ(n)=χ(n)n^(−(ρχ−399/400)), ∑χ|∑n b(n)vχ(n)|² ≤ (U+8|S|Q³)∑n|b(n)|².",
      "definitions": [
        "ξ(n)=χ(n)conj(ψ(n)) has period qχ qψ. Gχψ=∑n vχ(n)conj(vψ(n))."
      ],
      "dependencies": [],
      "equations": [
        "inputs-short-detector-sieve"
      ],
