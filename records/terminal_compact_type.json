  "claims": [
    {
      "id": "TEC-01",
      "chapter": "normalization",
      "anchor": "normalization-terminal-compact-model",
      "title": "A compact highest weight and a discrete-series model at the stopping parameter",
      "hypotheses": "A regular Harish-Chandra parameter μ for U(r,s) is ordered by decreasing coordinates. In mixed signature a lower bound h on absolute opposite-sign gaps satisfies h > max(2n,8n min(r,s)), where n=r+s. The distant-scale centers are separated by at least t with coordinate errors at most A√t.",
      "statement": "The weight L=μ+ρₙ−ρ𝒸 is integral and dominant on both compact factors. Shifting by C=∑|Lₐ| and twisting the resulting compact representation by the inverse Cth power of the full determinant constructs its irreducible K-type. The compact and mixed-signature constructions give at least one discrete-series model at μ whenever h>8n²+2n. The later coefficient comparison supplies occurrence inside the restriction.",
      "equations": [
        "normalization-terminal-compact-weight-difference",
        "normalization-terminal-twist-example"
      ],
      "dependencies": [
        "RSI-04",
        "KRL-05"
      ],
