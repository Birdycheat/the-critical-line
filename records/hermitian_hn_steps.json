  "claims": [
    {
      "id": "HNS-01",
      "chapter": "global",
      "anchor": "global-hn-steps",
      "title": "The Harder–Narasimhan steps of a Hermitian lattice and their sizes",
      "hypotheses": "Λ is the lattice at a point x: a finitely generated module over the ring of integers of the CM field E, spanning an n-dimensional E-space, realized through invertible frames at the infinite places with the majorant metric. f is the number of real places of the base field and t > 0.",
      "statement": "The closed step F≤t and the open step F<t are saturated, and F<t ⊆ F≤t ⊆ F<t′ for t < t′. A nonzero closed step has largest size at most t, and a nonzero open step largest size below t. Nonzero quotients beyond F≤t have size greater than t, and beyond F<t size at least t. In positive rank F≤t = 0 exactly when t < τ, and F<t = 0 exactly when t ≤ τ.",
      "definitions": [
        "ρN is the ℤ-lattice realizing N through the frames, deg N = −log covol(ρN) and μ(N) = deg N/(2f rk N).",
        "d = |disc E|^{1/(2f)} is the root discriminant of E, and size(N) = (2/d)^{1/2} e^{−μ(N)}.",
        "μ_min(N) is the least slope of a nonzero quotient of N by a saturated sublattice, μ_max(Λ) the greatest slope of a nonzero sublattice, and θ = log((2/d)^{1/2}/t)."
      ],
      "equations": [
        "global-hn-size-slope"
      ],
      "dependencies": [
        "PXL-01",
        "PXL-03"
      ],
