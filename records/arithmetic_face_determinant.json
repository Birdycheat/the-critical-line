    {
      "id": "NEX-01",
      "chapter": "inputs",
      "anchor": "inputs-face-real-gram",
      "title": "A lattice minimum forces positivity of every local Hermitian form",
      "statement": "For h with q_h(y)≥1 on every nonzero integral vector in 𝒪_L^N, the integral-basis real Gram G is positive definite, 1≤(4d)^d det G, and each local Hermitian matrix is positive definite.",
      "hypotheses": "L totally complex, one complex embedding in each conjugate pair, N≥1, d=[L:ℚ]N, and q_h the sum of the local Hermitian quadratic forms counted once per pair.",
      "correspondence": "The source extends nonnegativity from lattice points by homogeneity and continuity, applies a cube estimate to G+εI, passes to the determinant limit, and uses surjectivity in real embedding coordinates to test a single local place. The exposition proves the same cube bound directly using Minkowski and supplies the invertible-embedding-matrix justification for surjectivity.",
      "dependencies": [],
      "equations": [
        "inputs-face-gram-lower"
      ],
