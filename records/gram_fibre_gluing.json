  "claims": [
    {
      "id": "GFG-01",
      "chapter": "lifts",
      "anchor": "lifts-gram-fibre-gluing",
      "title": "One congruence chart carries normalized Gram-fibre measures",
      "statement": "On an open congruence orbit through a nonsingular target, the source is a group times a fixed fibre. Correcting each Haar measure by its pushforward character factors the corrected source into group Haar measure and a transverse measure. The regular conditional measures are transported with factor χ_H(h)/χ_V(h).",
      "hypotheses": "E/F is CM, J is a nonsingular Hermitian form defined over E before extension of scalars, the two measures are additive Haar, and n is the number of vectors. The exposition takes R to be a completion of F. The general local-ring result also permits a second-countable locally compact Hausdorff reduced Artinian topological F-algebra with Borel structure, open unit embedding and an open unit subgroup on which squaring is an open embedding into the unit group.",
      "correspondence": "The congruence chart and slice-product identity produce locally finite measures on a reference fibre and continuous integrals of tests on its orbit. Haar uniqueness is used in the rectangle argument.",
      "dependencies": [
        "GCC-02"
      ],
      "equations": [
        "lifts-gram-fibre-disintegration"
      ],
