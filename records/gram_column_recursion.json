  "claims": [
    {
      "id": "GCR-01",
      "chapter": "lifts",
      "anchor": "lifts-gram-column-recursion",
      "title": "Fixing the first vector leaves the Gram fibre in its orthogonal complement",
      "statement": "In the represented orthogonal decomposition ⟨t⟩⊕J, a first vector of norm t is h_y e. For target ⟨t⟩⊕T the remaining columns are h_y(0,X_j) with Gram_J(X)=T. Nearby targets have complement B−b*b/x, and det S=x det(B−b*b/x).",
      "hypotheses": "E/F is CM and R is one completion of the totally real F. Work with a fixed scalar t in F×, a nonsingular J of dimension r, and a nonsingular Hermitian target T of size n. The rank condition of the global theorem is separate.",
      "correspondence": "The moving frame can be chosen measurably and compactly controlled on the orbit. Changing the chosen frame multiplies on the right by the stabilizer of e, whose action on the complement preserves its Gram measure.",
      "dependencies": [],
      "equations": [
        "lifts-gram-column-schur"
      ],
