    {
      "id": "BVD-01",
      "chapter": "normalization",
      "anchor": "normalization-branching-derivative-energy",
      "title": "Derivative energy through the compact types of a smooth lowest-type vector",
      "hypotheses": "A signed unitary discrete series of rank m≥2 and regular λ on its Harish-Chandra lattice. The parameters satisfy |λa|≤B and gaps ≥100m³ across opposite signs. The starting lowest compact type is smooth.",
      "statement": "For x in the kth layer above the lowest compact type, k≤S, the sum of squared matrix-unit derivative norms is at most 64m(B+S)²‖x‖².",
      "definitions": [
        "Λ=λ+ρn−ρc, and a weight μ in the kth layer lies within √2k of Λ.",
        "Infinitesimal unitarity identifies the energy with the real quadratic form of 2ΩK−Ω."
      ],
      "dependencies": [
        "DSD-01",
        "DSD-02",
        "KRL-05"
      ],
      "equations": [
        "normalization-branching-derivative-energy-bound"
      ],
