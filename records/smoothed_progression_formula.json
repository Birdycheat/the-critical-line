  "claims": [
    {
      "id": "SPF-01",
      "chapter": "inputs",
      "anchor": "inputs-smoothed-progression-formula",
      "title": "A truncated rectangle gives the normalized smoothed prime sum and its local zero multiplicities",
      "statement": "For a character modulo m, Sχ(y)/y equals a constant Kχ plus the principal logarithm log y−1 minus the finite sum of aρ y^(ρ−1)/[ρ(ρ−1)], with error bounded by Cκ[(mT)^Cκ y^(−κ/2)+(log y)log²(mT)/T]. The outer list lies in Re ρ>1−κ and |Im ρ|≤T+1 and contains every zero at Re ρ≥1−κ/2, |Im ρ|≤T. Local multiplicities sum to O(log(m(|t|+2))).",
      "hypotheses": "m≥3, T≥2, 0<κ≤1/20, y≥2, χ a Dirichlet character modulo m; no primitivity restriction. The left side, heights and zero list are fixed before y varies. The moving right side remains in Re s>1.",
      "definitions": [
        "Sχ(y) sums Λ(n)χ(n)(y/n−1) up to y. The constant is −Fχ′(1)/Fχ(1), where the pole of the principal L-function has been removed."
      ],
      "dependencies": [
        "LZE-02"
      ],
      "equations": [
        "inputs-progression-smoothed-identity"
      ],
