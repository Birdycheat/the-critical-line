  "claims": [
    {
      "id": "CRC-01",
      "chapter": "inputs",
      "title": "Congruences force a kernel character to vanish on the intersection with a generator closure",
      "anchor": "inputs-cyclotomic-cocycles-intersection",
      "statement": "For a lift γ of a topological generator of the cyclotomic image, C=closure⟨γ⟩ and U=ker χ satisfy CU=G. Every locally constant additive ℓ-primary character φ on U vanishes on C∩U. For a continuous coefficient action trivial on U, an equivariant φ extends by z(cu)=ρ(c)φ(u) to a continuous cocycle.",
      "hypotheses": "F a number field and χ its ℓ-adic cyclotomic character. A generator of infinite cyclotomic order exists for ℓ odd, or when χ is trivial modulo 4 at ℓ=2. The intersection argument uses local constancy and ℓ-primary torsion of the target. The extension assumes a discrete coefficient module with continuous action and conjugation equivariance of φ.",
      "definitions": [
        "U=ker χ and C is the closure of all integer powers of γ in the absolute Galois group.",
        "The subgroup H fixes a finite field extension and is open in G. Its coset space is finite.",
        "For a positive d with γ^d in that subgroup write d=ℓ^a b with b prime to ℓ."
      ],
      "equations": [
        "inputs-cyclotomic-cocycles-product"
      ],
