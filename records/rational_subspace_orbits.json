    {
      "id": "RSO-01",
      "chapter": "global",
      "anchor": "global-subspace-defect-ideal",
      "title": "The bad ideal and the common determinant line",
      "hypotheses": "Two equal-dimensional totally positive definite Hermitian subspaces over a CM extension unramified at all finite places. Maximal lattices in the subspaces have the same bad prime ideals.",
      "statement": "The product of bad ideals has norm equal to the discriminant order of the maximal lattice. Adding the line of length β, the determinant of the first space, makes both enlarged spaces admit orthonormal bases.",
      "equations": [
        "global-subspace-ideal-index"
      ],
      "dependencies": [
        "DML-01",
        "MHC-01"
      ],
