    {
      "id": "RSO-03",
      "chapter": "global",
      "anchor": "global-rational-subspace-orbit-count",
      "title": "The number of rational orbits at fixed discriminant order",
      "hypotheses": "Fix a dimension j and a positive discriminant order n in the same totally positive definite ambient Hermitian space. Write D for the absolute field degree.",
      "statement": "At most n^(1+log₂ D) ambient rational isometry orbits suffice. A maximal enlargement gives an ideal of norm at most n. One orbit covers each realized ideal, and at most D^Ω(k) ideals have norm k.",
      "equations": [
        "global-orbits-ideal-norm-sum"
      ],
      "dependencies": [
        "RSO-02"
      ],
