    {
      "id": "RSO-02",
      "chapter": "global",
      "anchor": "global-subspace-witt-extension",
      "title": "A rational isometry on a subspace extends to the ambient space",
      "hypotheses": "A finite-dimensional totally positive definite Hermitian space over the same CM field. The two enhanced spaces in the cancellation step have the same nonzero line.",
      "statement": "Moving equal-length vectors by a rank-one correction proves definite Witt extension. Its first use cancels the added line. Its second use carries subspaces with the same bad ideal onto one another in the original ambient space.",
      "equations": [
        "global-subspace-witt-move"
      ],
      "dependencies": [
        "RSO-01"
      ],
