  "claims": [
    {
      "id": "ACP-01",
      "chapter": "inputs",
      "title": "Ordered products of edge characters are invariant real cocycles",
      "anchor": "inputs-additive-cups",
      "statement": "For a free abelian group A of finite rank, the homogeneous j-cochain Cα evaluates j real additive characters on successive edge increments and multiplies the resulting scalars, with no factorial. It is invariant and closed.",
      "hypotheses": "Trivial real coefficients. The affine application uses positive degree j=q+1. Each j-cochain takes j+1 vertices; simultaneous translation of all vertices preserves its value.",
      "definitions": [
        "δ omits vertex i with sign (−1)^i, starting at i=0. All tuples of vertices are allowed.",
        "Cα(y₀,…,yⱼ)=∏ᵢ₌₁ʲ αᵢ(yᵢ−yᵢ₋₁).",
        "For a leading character ℓ and any homogeneous cochain e, δ(ℓ∪e)=−ℓ∪δe."
      ],
      "equations": [
        "inputs-additive-cup-word"
      ],
