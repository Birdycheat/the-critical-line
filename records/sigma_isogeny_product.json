  "claims": [
    {
      "id": "SIG-01",
      "chapter": "normalization",
      "anchor": "normalization-sigma-isogeny-product",
      "title": "Sigma product identity for an elliptic isogeny",
      "statement": "For a nonzero multiplier preserving the period lattice and a finite set of nonzero kernel representatives, the squared normalized sigma value at αz equals α² times the corresponding power of sigma at z and the product of the ℘(z)−℘(P) factors.",
      "hypotheses": "A complex lattice Λ, a nonzero multiplier preserving Λ and a full set of representatives of its nonzero kernel classes. The evaluation point lies outside Λ.",
      "equations": [
        "normalization-sigma-isogeny-equation"
      ],
