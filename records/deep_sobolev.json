    {
      "id": "CSE-01",
      "chapter": "global",
      "anchor": "global-deep-sobolev",
      "title": "Ordered-cube evaluation from a derivative bound",
      "statement": "A full-cube integral bound C‖w‖² through order P+N and derivative bound β give |F_u(y)|²≤(2/s+2sβ²)^N C‖u‖² for vectors through order P. The choice s=1/β gives (4β)^N.",
      "hypotheses": "Positive side length, continuous representatives, fixed ordered one-parameter subgroups, and differentiation acting on the increasing filtration by at most one step.",
      "correspondence": "The proof removes the last coordinate, applies the one-dimensional endpoint inequality and integrates the remaining parameters.",
      "dependencies": [],
      "equations": [
        "global-sobolev-endpoint"
      ],
