    {
      "id": "OCR-01",
      "chapter": "inputs",
      "anchor": "inputs-odd-class-reflection",
      "title": "Reflection of unramified plus characters into minus ideal classes",
      "statement": "For an odd prime ℓ and a CM field K containing a primitive ℓth root of unity, let J act on C=Cl(K). The index of ℓC+(1−J)C in C is at most ℓ times the size of the anti-invariant ℓ-torsion in C.",
      "hypotheses": "K is a CM number field. Its primitive ℓth root lies in K. Characters come from the ordinary ideal class group and are unramified at all finite primes, including the primes above ℓ.",
      "dependencies": [],
      "equations": [
        "inputs-odd-reflection-inequality"
      ],
