    {
      "id": "PCT-02",
      "chapter": "normalization",
      "anchor": "normalization-positive-column-trace",
      "title": "The positive partial trace on generated tensor columns",
      "hypotheses": "In addition to the signed pairing, P is an equivariant idempotent, self-adjoint for the signature pairing. Its image is in one tensor eigenspace and its partial trace acts by c on the derivative module.",
      "statement": "The closed span of projected coefficient columns has readers w_b with c=Σ‖w_b‖²/d. In particular c is real and nonnegative, and c=0 forces P to vanish on all generated columns.",
      "definitions": [
        "Q is ordinary orthogonal projection onto the coefficient space and κ=d/‖y‖²."
      ],
      "equations": [
        "normalization-column-reproducing",
        "normalization-positive-trace-formula"
      ],
