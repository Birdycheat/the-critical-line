    {
      "id": "PCT-03",
      "chapter": "normalization",
      "anchor": "normalization-column-degree-equality",
      "title": "The exact formal-degree defect of a shifted subspace",
      "hypotheses": "A nonzero closed irreducible invariant copy of formal degree d′ is contained in the coefficient space with trace scalar c and readers w_b. All formal degrees use the same Haar measure.",
      "statement": "If E is ordinary orthogonal projection onto the copy, dc−d′=Σ‖(I−E)w_b‖². Equality forces the whole coefficient space to coincide with that copy.",
      "definitions": [
        "E is the orthogonal projection onto the embedded closed copy."
      ],
