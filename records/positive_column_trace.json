  "claims": [
    {
      "id": "PCT-01",
      "chapter": "normalization",
      "anchor": "normalization-signed-column-pairing",
      "title": "A signed coefficient pairing that separates tensor columns",
      "hypotheses": "The original model is irreducible square-integrable of formal degree d>0, the test vector y is nonzero in its lowest compact type, and the weighted coefficients of generated vectors are square-integrable. The dual matrix preserves the signature J.",
      "statement": "The signed L² pairing of two coefficient columns is ‖y‖²/d times the signed tensor pairing. Testing against the sign-reversed input gives injectivity.",
      "definitions": [
        "B(f,h)=⟨f,Jh⟩, with signs on the finite tensor factor."
      ],
      "equations": [
        "normalization-signed-column-identity"
      ],
