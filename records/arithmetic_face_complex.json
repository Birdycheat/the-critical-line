    {
      "id": "NEX-03",
      "chapter": "inputs",
      "anchor": "inputs-face-normal-cover",
      "title": "The normal cones giving the arithmetic faces",
      "statement": "Every strictly positive functional on the semidefinite cone minimizes at a vertex of the feasible Hermitian set. Only finitely many vertex cones meet the convex hull of any finite set of such functionals.",
      "hypotheses": "A totally complex number field, positive rank, and the inequalities q_y(h) ≥ 1 on every nonzero integral column.",
      "dependencies": [
        "NEX-01"
      ],
      "equations": [
        "inputs-face-normal-family"
      ],
