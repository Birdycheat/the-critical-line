    {
      "id": "NEX-05",
      "chapter": "inputs",
      "anchor": "inputs-face-augmentation",
      "title": "Exactness of the arithmetic face complex in every finite degree",
      "statement": "The augmented integral permutation complex on arithmetic faces is exact. For each finitely supported cycle its filling is obtained within the nerve on a compact convex hull of finitely many witnesses.",
      "hypotheses": "The group is GL_N of the integers of a totally complex number field, N ≥ 1. The action sends each supporting functional to its pullback.",
      "dependencies": [
        "NEX-03",
        "NEX-04"
      ],
