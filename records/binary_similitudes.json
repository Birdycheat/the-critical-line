  "claims": [
    {
      "id": "BSM-01",
      "chapter": "lifts",
      "anchor": "lifts-binary-similitudes",
      "title": "Rational frames identify two represented nonzero lengths in a Hermitian plane",
      "statement": "For x, x′ in E² of lengths β, β′ in F×, a rational similitude γ in GL₂(E) sends x to x′ and satisfies γ*Jγ=(β′/β)J. It gives a bijection of the whole rational spheres and pushes the normalized theta measure at β to that at β′.",
      "hypotheses": "For a fixed CM extension E/F, the binary application uses a nondegenerate anisotropic Hermitian form, standard additive Haar measures in the chosen base-field coordinates, a Haar measure and fundamental domain for the adelic unitary quotient, and the normalized local Gram-fibre families. The frame identity itself uses only the involution, the Hermitian matrix and the nonzero displayed lengths.",
      "definitions": [
        "Hermitian length",
        "rational sphere",
        "similitude multiplier",
        "normalized theta measure"
      ],
      "equations": [
        "lifts-binary-frame-identity"
      ],
      "dependencies": [],
      "correspondence": "Set Pₓ=[x, (−r₁,r₀)ᵗ] for (r₀,r₁)=x*J. Its determinant is β and its Gram matrix is β diag(1,det J). Take γ=Pₓ′Pₓ⁻¹. Reindex the rational sphere and conjugate the unitary variable h by γ; pulling back its Haar measure and fundamental domain together preserves the denominator. Independence of choices gives the assertion for the original choices.",
