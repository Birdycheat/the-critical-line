  "claims": [
    {
      "id": "PPM-01",
      "chapter": "inputs",
      "anchor": "inputs-quadratic-divisor-interval",
      "title": "A harmonic divisor interval for a quadratic character",
      "statement": "The coefficient Λ(n)(χ₀(n)+χ₁(n)) is nonnegative and bounded by 2 log(n) r(n). On (y,x] the sum of r(n)/n is at most |L(1,χ₁)|log(x/y)+400m(1+log y)/√y.",
      "hypotheses": "m≥3; nonprincipal quadratic character modulo m; 1≤y≤x.",
      "definitions": [
        "r(n)=Σ_{b|n}χ₁(b); F(N)=Σ_{n≤N}r(n)/n; split ab≤N at b=⌊√N⌋."
      ],
      "dependencies": [],
      "equations": [
        "inputs-quadratic-divisor-bound"
      ],
