    {
      "id": "LTR-01",
      "chapter": "inputs",
      "title": "A lower bound for the dual gives a short primitive direction",
      "anchor": "inputs-transference-short",
      "statement": "A positive definite symmetric real Gram matrix G of size d≥1 with Q_(G⁻¹)(c)≥δ>0 on every nonzero integral covector has a primitive integer vector v with Q_G(v)≤2(4d)²/δ.",
      "hypotheses": "The lattice is ℤᵈ. Its covectors have integral coordinates in the dual basis. A unimodular change of basis acts on covectors by the inverse transpose.",
      "definitions": [
        "Q_G(x)=xᵀGx is the squared length.",
        "The threshold ℓ in the determinant bound is positive.",
        "A primitive column has greatest common divisor of its coordinates equal to one."
      ],
