    {
      "id": "APW-01",
      "chapter": "lifts",
      "anchor": "lifts-primitive-witness-local",
      "title": "A largest coordinate normalizes a column and its dual locally",
      "hypotheses": "A CM quadratic extension E/F of number fields; finite column length M; existence of a row z₀ with the ordinary dot product z₀·y=1. At infinity work per complex factor, at a split finite place per field component.",
      "statement": "At each place there is a compact box, independent of the primitive column y, containing a scalar-normalized column ay and a replacement row z with z·(ay)=1. Separate maximal coordinates are allowed in distinct components.",
      "definitions": [
        "In a field factor choose a nonzero pivot y_r of maximal size and set a=1/y_r and z=e_r; in a nonsplit finite algebra use the absolute norm as multiplicative size."
      ],
      "dependencies": [],
      "equations": [
        "lifts-primitive-witness-identity"
      ],
