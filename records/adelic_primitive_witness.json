    {
      "id": "APW-02",
      "chapter": "lifts",
      "anchor": "lifts-adelic-primitive-witness",
      "title": "One restricted-product compact set and a single invertible adelic scalar",
      "hypotheses": "Same quadratic CM data and rank; fixed F-basis of E; y,z₀ are adelic coordinate tuples satisfying z₀·y=1. Integrality for the chosen basis is required only at almost all finite places.",
      "statement": "There exists a compact Ω in (A_F ⊗_F E)^M independent of y. Choosing a_v=1 and the old witness at the almost-everywhere good places where both old tuples are integral, the remaining local scalars and their inverses glue to an idèle a. The local replacement rows glue to z with ay,z in Ω and z·(ay)=1.",
      "definitions": [
        "Λ_v is the box of tuples with integral entries in a fixed global basis; Ω is a product of Λ_v off a fixed finite set and of local compact sets at the remaining places.",
        "Local primitivity at each individual place does not imply adelic primitivity. In rank one, y_p=p at all rational primes is adelic, while its only possible dual (1/p)_p fails the integrality condition."
      ],
      "dependencies": [
        "APW-01"
      ],
      "equations": [
        "lifts-primitive-witness-local-norm"
      ],
