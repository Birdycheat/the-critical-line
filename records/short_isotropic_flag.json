    {
      "id": "SIF-02",
      "chapter": "global",
      "anchor": "global-short-isotropic-rank",
      "title": "Perpendicular size cuts give an isotropic subspace of bounded local rank",
      "equations": [
        "global-short-isotropic-duality",
        "global-short-isotropic-witt"
      ],
      "dependencies": [
        "SIF-01"
      ],
      "hypotheses": "Use self-duality of the normalized Hermitian determinant metric, the orthogonal reciprocity for the two canonical filtration steps, and the local signature at every real place.",
      "statement": "The perpendicular of the open half step is the closed step at two, so inclusion gives total isotropy. At every real place the two signature projections inject on this subspace, proving that its rational rank, and hence the number of jumps, is bounded by the local Witt index.",
