    {
      "id": "HMA-02",
      "chapter": "global",
      "anchor": "global-hyperplane-stratum-mass",
      "title": "A maximal discriminant retains a denominator in the hyperplane mass",
      "hypotheses": "Fix one realized hyperplane U with bad-prime product m under the assumptions of the preceding count. Let Mⱼ be the orthonormal reference mass.",
      "statement": "The mass of integral lattice classes of discriminant order d² inside U is at most Mⱼ d^(j+λ)/m^λ, where λ = log₂(2f).",
      "equations": [
        "global-hyperplane-one-stratum"
      ],
      "dependencies": [
        "HMA-01",
        "DML-01",
        "DML-02"
      ],
