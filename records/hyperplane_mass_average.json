    {
      "id": "HMA-03",
      "chapter": "global",
      "anchor": "global-hyperplane-summed-mass",
      "title": "A uniform contribution per divisor bounds the sum over hyperplanes",
      "hypotheses": "Fix j ≥ 1, d ≥ 1 and the same definite Hermitian space. For the application to row lattices, T is the completely split level prime and t = T^f.",
      "statement": "Summing the fixed-order masses over a rational orbit cover costs at most Mⱼ d^(j+2+log₂ f). The uniform perpendicular-line and gluing bounds multiply this sum in the marked row numerator.",
      "equations": [
        "global-hyperplane-total-mass"
      ],
      "dependencies": [
        "HMA-01",
        "HMA-02",
        "LMC-02",
        "HLG-02"
      ],
