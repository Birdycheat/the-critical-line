  "claims": [
    {
      "id": "HMA-01",
      "chapter": "global",
      "anchor": "global-hyperplane-defect-sets",
      "title": "The number of bad-prime sets at one determinant divisor",
      "hypotheses": "A totally definite Hermitian space over a CM field of degree D = 2f, unramified over its real field at finite places. Choose a hyperplane dimension j ≥ 1 and exact determinant d ≥ 1.",
      "statement": "If m is the product of the residue sizes in the real field at the bad primes of a maximal enlargement, then m divides d, the lattice index is d/m, and at most m^log₂D sets of bad primes occur for that m.",
      "equations": [
        "global-hyperplane-defect-index"
      ],
      "dependencies": [
        "RSO-01",
        "RSO-02"
      ],
      "sources": [
