    {
      "id": "QCP-02",
      "chapter": "normalization",
      "anchor": "normalization-quantum-cofactor-identity",
      "title": "Right multiplication of the quantum comatrix by the shifted generator matrix",
      "hypotheses": "The same ordered minors and the column alternation of QCP-01; m=N+1.",
      "statement": "C(u)((u−N)Id+E) is the diagonal matrix with the full Capelli determinant in every diagonal entry. The (i,j) entry of C deletes row j and column i.",
