  "claims": [
    {
      "id": "TCM-01",
      "chapter": "inputs",
      "title": "The commutant of the place permutations is spanned by block-unitary tensor powers",
      "anchor": "inputs-trace-interpolation",
      "statement": "If a matrix Z commutes with every P(σ,w) on V⊗q, it belongs to the complex span of D⊗q for all independent unitary blocks D=diag(u_w). Conversely each such tensor power commutes with the generators.",
      "hypotheses": "W finite, V the direct sum over W of copies of complex N-space, q and N arbitrary natural numbers. Characteristic zero is used to divide by q! in the proof. No comparison of N and q enters the theorem.",
      "definitions": [
        "Rows and columns are words of q pairs (place, coordinate). P(σ,w) has entry one exactly for row pattern w and J=I∘σ.",
        "An entry of Z can survive only on matching place words and is unchanged under simultaneous permutations of the row and column slots.",
        "The coefficient of t₁⋯t_q in (∑ᵢtᵢE_{Iᵢ,Jᵢ})⊗q is the permutation sum of the associated matrix units, with all stabilizer multiplicities."
      ],
      "equations": [
        "inputs-trace-place-permutation",
        "inputs-trace-orbit-sum"
      ],
