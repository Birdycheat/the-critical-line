  "claims": [
    {
      "id": "SHT-01",
      "chapter": "inputs",
      "anchor": "inputs-stabilizer-homology-transfer",
      "title": "A finite stabilizer kills its positive-degree integral homology by its order",
      "statement": "For a transitive nonempty G-set X with stabilizer S, H_j(G,ℤ[X])≅H_j(S,ℤ) in all degrees. If S has finite order h, the norm and augmentation through ℤ[S] show that multiplication by h vanishes on H_j(S,ℤ) for j>0. Their degree-zero composite multiplies ℤ by h.",
      "hypotheses": "G is a discrete group, X a left G-set and x a specified point. Coefficients on the stabilizer are integral and trivial in the application. Finiteness is required only for the norm of all elements and the order bound.",
      "correspondence": "The text proves homological Shapiro by restricting a free resolution and identifies X with the left cosets G/S. The archive indexes induced generators by the inverse group element, then applies its homological Shapiro isomorphism. Both proofs of annihilation factor the order map through the regular coefficient module.",
      "dependencies": [],
      "equations": [
        "inputs-stabilizer-shapiro"
      ],
