  "claims": [
    {
      "id": "PVC-01",
      "chapter": "global",
      "anchor": "global-period-volume-comparison",
      "title": "The large compact block in the short-flag volume",
      "statement": "If n≥18, J≤p≤n and p−J≥max(n/2,n−2√n), then log(S(p)/S(p−J))≤J[log(2π)−(n−2√n)log(n/(2πe))], where S(r) is the product of the unit sphere areas in complex dimensions 1 through r.",
      "hypotheses": "Integers n, p, J≥0. The inequality holds for the empty interval J=0. The field and the adelic measures enter only when this scalar ratio is used in a flag coefficient.",
      "definitions": [
        "A_m=2π^(m+1)/m!, the area of the unit sphere in ℂ^(m+1).",
        "S(0)=1 and S(r)=∏_{0≤m<r}A_m. The unitary group volume convention also contains a separate factor 2^(r(r−1)/2)."
      ],
      "dependencies": [],
      "equations": [
