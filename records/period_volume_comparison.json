    {
      "id": "PVC-02",
      "chapter": "global",
      "anchor": "global-period-volume-blocks",
      "title": "The compact contribution to the probability of one short flag",
      "statement": "For rank jumps of total J and f real places, log(C^f) ≤ fJ[c−(n−2s)(L−c−1)+3.49+sL/4] where C=S(p)S(q)/(S(p−J)S(q−J)∏S(j_i)), s=√n, L=log n and c=log(2π).",
      "hypotheses": "Common signature (p,q), n=p+q, log n≥15, q²≤n, positive integer rank jumps summing to J≤q. The single-place computation uses only these numerical inequalities. The ambient short-flag probability has additional arithmetic hypotheses.",
      "definitions": [
        "The quotient S(q)/S(q−J) costs at most 3.49J in its logarithm.",
        "Each inverse jump factor costs at most j_i s log(s)/2, so the total costs at most JsL/4."
      ],
