  "claims": [
    {
      "id": "LCL-01",
      "chapter": "inputs",
      "title": "Reduction of the localization kernel at a finite coefficient level",
      "anchor": "inputs-local-cohomology-lift",
      "statement": "Let λ:X→Y be the integral degree-two restriction map, B=λ(X), K=ker λ, C=Y/B, and let t=ℓ^r with r≥1. The finite-coefficient map λ_r is λ modulo t. Its cokernel is C/tC. The image of K in ker λ_r is K/(K∩tX), and it fills the finite-level kernel exactly when B∩tY=tB. In the nonzero-twist arithmetic case this holds for all sufficiently large r.",
      "hypotheses": "L is a number field, ℓ prime, S the finite places above ℓ with chosen prolongations. T=ℤ_ℓ(e+1), A=(ℚ_ℓ/ℤ_ℓ)(−e). The arithmetic identification of the reduced groups uses finite global Poitou–Tate in its valid case, local Tate duality and local finiteness. The algebraic lifting criterion holds for any homomorphism of ℤ_ℓ-modules. Bounding the exponent of Y by the argument given uses e≠0.",
      "definitions": [
        "G_S is the global Galois group unramified outside S. X=H²(G_S,T), Y=∏_{v∈S}H²(D_v,T), with the local action pulled back by each decomposition group map.",
        "The coefficient dual of T/ℓ^rT with cyclotomic factor is A[ℓ^r].",
        "K∩tX denotes the intersection in the ambient integral X."
      ],
      "equations": [
        "inputs-local-cohomology-square"
      ],
