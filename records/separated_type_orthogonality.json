  "claims": [
    {
      "id": "STO-01",
      "chapter": "normalization",
      "anchor": "normalization-separated-type-layers",
      "title": "Excluding a second lowest highest weight in the algebraic derivative layers",
      "hypotheses": "V is a nonzero irreducible compact-stable smooth type of weight L=μ+ρn−ρc in a unitary representation of U(r,s). Its full Casimir scalar is ‖μ‖²−‖ρ‖². The strictly decreasing parameter has opposite-sign gaps ≥h with h>nrs+1 and n=r+s.",
      "statement": "A nonzero compact highest vector of weight γ in Fk perpendicular to Fk−1 has compact Casimir at least cK(L)+2k(h−n+1). Every highest vector of weight L in the derivative module therefore lies in F0=V.",
      "definitions": [
        "Fk is the span of words on V involving at most k noncompact derivatives. The compact Casimir on highest weight γ is cK(γ)=‖γ+ρc‖²−‖ρc‖²."
      ],
      "equations": [
        "normalization-separated-type-layer-gap"
      ],
      "dependencies": [
        "TBT-01"
      ],
