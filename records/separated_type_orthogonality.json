    {
      "id": "STO-02",
      "chapter": "normalization",
      "anchor": "normalization-separated-type-orthogonality",
      "title": "Orthogonality to the whole orbit from compact-equivariant projections",
      "hypotheses": "V and τ satisfy the separated-type and fixed Casimir conditions. B is a compact-equivariant map from V to the Hilbert space, with BV perpendicular to V. The closed derivative module contains noncompact exponentials of its algebraic vectors.",
      "statement": "Every Bu is perpendicular to τ(g)V for all g. The projection of the image of a highest vector to each finite layer has the same compact highest weight and lies in V, forcing its squared norm to vanish. Compact irreducibility, closure and polar decomposition give the conclusion.",
      "equations": [
        "normalization-separated-type-orthogonal-orbits",
        "normalization-separated-type-projected-norm"
      ],
      "dependencies": [
        "STO-01"
      ],
