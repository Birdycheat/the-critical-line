    {
      "id": "SDT-02",
      "chapter": "inputs",
      "anchor": "inputs-short-detector-blocks",
      "title": "One large block among exactly J half-open intervals",
      "hypotheses": "Q≥20, primitive χ of conductor 1<q≤Q, L(ρ,χ)=0, Re ρ>399/400, |Im ρ|≤Q. Y and N are positive integral cutoffs in the finite Möbius identity.",
      "statement": "With X=ceil Q, Y=X⁴, J=8(floor(log₂X)+1), N=2^J, the product of the first N L-terms and the first Y Möbius terms has norm at most 3/X≤1/2. Its nonconstant tail splits over (Y2^j,Y2^(j+1)] for 0≤j<J; at least one block has modulus ≥1/(2J). The selected zeros also satisfy Re ρ<1 by nonvanishing for nonprincipal characters on Re s≥1, as required by the subsequent block estimate.",
      "definitions": [
        "The constant coefficient of P_N M_Y is 1, the coefficients for 2≤n≤Y vanish, and its support ends at YN. The terminal block is (YN/2,YN]."
      ],
      "dependencies": [
        "SDT-01"
      ],
      "equations": [
        "inputs-short-detector-product",
        "inputs-short-detector-selection"
      ],
