  "claims": [
    {
      "id": "SDT-01",
      "chapter": "inputs",
      "anchor": "inputs-short-detector-tail",
      "title": "Uniform partial sums of a nonprincipal L-function at a zero",
      "hypotheses": "Nonprincipal character χ modulo q; |A(n)|≤B at each n for A(n)=∑_{k=1}^n χ(k); integer N≥1; σ=Re s>0. One may choose B=q+1.",
      "statement": "The Abel series ∑n≥1 A(n)(n^(−s)−(n+1)^(−s)) represents L(s,χ). Subtracting P_N gives a telescoping tail and the boundary −A(N)(N+1)^(−s), bounded together by B(1+|s|/σ)(N+1)^(−σ) ≤ 2B(1+|s|/σ)N^(−σ).",
      "definitions": [
        "P_N(s) is the sum of χ(n)n^(−s) for 1≤n≤N."
      ],
      "dependencies": [],
