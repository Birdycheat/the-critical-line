    {
      "id": "RTC-02",
      "chapter": "normalization",
      "anchor": "normalization-regular-shift-averaging",
      "title": "Obtaining and separating smooth tensor maps by averaging",
      "hypotheses": "Under the hypotheses of the regular shift theorem, use an inversion-invariant Haar measure on the unitary group. The compact-finite coefficient identities hold and the original coefficient has decay of order m²+2 in the group size.",
      "statement": "An inverse tensor coefficient averaged against a translated vector in a shifted model gives a smooth intertwining map. For every regular shift there is a nonzero map, and the common kernel of all maps to all shifted models is zero.",
      "definitions": [
        "The test coefficient evaluates one coordinate of A(g⁻¹)x against a smooth test vector.",
        "The formal degree dπ is defined for the same Haar measure as both integrals."
      ],
