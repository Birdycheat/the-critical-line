  "claims": [
    {
      "id": "RTC-01",
      "chapter": "normalization",
      "anchor": "normalization-regular-shift-models",
      "title": "Building the discrete series at each regular shifted weight",
      "hypotheses": "The group is U(p,q) with 1≤q≤p, m=p+q. The discrete series π has a strictly decreasing Harish-Chandra parameter λ with the required weight lattice and opposite-sign gap h≥200m³.",
      "statement": "A lowering at s gives a model with the original signature precisely at a regular shifted parameter. Compact-finite tensor coefficients are finite sums of shifted coefficients, and each shifted model supplies a nonzero diagonal coefficient expressible using the tensor.",
      "definitions": [
        "K-finite means that the span of all compact translates of the vector is finite-dimensional.",
        "On a lowest compact type the normalized kernel supplies coefficient functions in L²(G). Their differential span and Hilbert closure realize the shifted model."
      ],
      "dependencies": [
        "RTC-04",
        "RSI-04",
        "RSI-07",
        "KRL-05"
      ],
      "equations": [
        "normalization-regular-coefficient-expansion"
      ],
