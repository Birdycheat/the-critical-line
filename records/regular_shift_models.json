    {
      "id": "RTC-04",
      "chapter": "normalization",
      "anchor": "normalization-regular-shift-residues",
      "title": "Using finite moments and positivity to exclude a singular lowering",
      "hypotheses": "The hypotheses of regular tensor translation hold on the tensor generated by the lowest compact type. The finite spectral decomposition, the central-character moments and the positive partial-trace formula are available there.",
      "statement": "A candidate pole for the negative dual tensor differential has a nonzero eigenspace precisely when the product of the unit-lowering residue factors is nonzero. A tie with the next weight forces one factor to vanish.",
      "definitions": [
        "The partial trace sums the diagonal entries as operators on the original module.",
        "Lagrange interpolation on the finite union of both spectral supports recovers the total weight at each individual value."
      ],
      "dependencies": [
        "PCT-02",
        "RSI-03",
        "RSI-05"
      ],
      "equations": [
        "normalization-regular-residue-moments"
      ],
      "sources": [
        {
