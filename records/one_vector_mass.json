  "claims": [
    {
      "id": "OVM-01",
      "chapter": "lifts",
      "title": "A finite-lattice dilation bounds the discrepancy of a single coefficient",
      "anchor": "lifts-one-vector-mass",
      "statement": "Fix a nonzero scalar Gram target β, with all fibre measures nonzero. A single positive archimedean test with finite positive fibre integral w and a constant C work for every integer a≥1. For the test with finite support a⁻¹Λ, the absolute difference between the averaged one-vector count I(a) and the reference product wP(a) is at most C a^{dM}, where d=[F:ℚ].",
      "hypotheses": "F is totally real, E/F is CM, the Hermitian form on E^M is nondegenerate and M≥3. Use the specified Haar quotient probability and compatible coordinate measures in the one-vector Siegel–Weil measure statement. The archimedean Gram fibre has locally finite nonzero measure.",
      "equations": [
        "lifts-one-vector-discrepancy"
      ],
      "dependencies": [
        "SDR-02",
        "SCR-01",
        "SCR-03",
        "ODN-01",
        "ODN-02",
        "ODN-03"
      ],
