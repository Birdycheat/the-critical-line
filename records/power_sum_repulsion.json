  "claims": [
    {
      "id": "PSR-01",
      "chapter": "inputs",
      "anchor": "inputs-power-sum-repulsion",
      "title": "Positive prime moments bound a list of shifted zero distances containing the target",
      "statement": "For a distinct labelled zero satisfying the repulsion hypotheses and Δ=1−Re ρ, the shifted local zero distances w have Re w≥Δ and include 2Δ. Their first reciprocal moment has real part ≤2λ/Δ²+25 C_F H and the absolute j-th moment is bounded by the principal-plus-quadratic prime moment plus 2jλ/Δ^(j+1)+C_F H25^j.",
      "hypotheses": "m≥3, T≥2, |Im ρ|≤T, χ₁ a nonprincipal quadratic character modulo m, L(β,χ₁)=0, 0<λ=1−β<c₁/H, H=log(mT), (χ,ρ)≠(χ₁,β), and Δ≤c₀. The constants are chosen uniformly so β≥19/20, β≥1−1/log(3m), and Δ≤1/25.",
      "definitions": [
        "w=s₁−ρ′, with s₁=1+Δ+i Im ρ, from the two shifted character lists after erasing one eligible exceptional occurrence.",
        "P_{j−1} is the real signed factorial-normalized (j−1)st derivative of the sum of the principal and quadratic negative logarithmic derivatives at 1+Δ."
      ],
      "dependencies": [
        "LZE-01"
      ],
      "equations": [
        "inputs-power-sum-gain",
        "inputs-power-sum-moments"
      ],
