  "claims": [
    {
      "id": "CUD-01",
      "chapter": "inputs",
      "anchor": "inputs-compact-unfolding-frame",
      "title": "Uniform scalar and determinant-one frames for positive matrices",
      "statement": "On a compact family of positive definite Hermitian N×N matrices, every Q has Q=(Y⁻¹)*Y⁻¹ with Y=cT and det T=1. If |(Q⁻¹)ᵢⱼ|≤R₂ and det Q≤R₃ then the entries of both Y and T are bounded by R=max(1,R₂)max(1,R₃). The complex scalar satisfies |c|^(2N)det Q=1.",
      "hypotheses": "N≥1. The matrices are complex Hermitian at every index in the finite set of infinite places. The bounds can be imposed on the enlarged compact set of the application.",
      "correspondence": "The source obtains Y by inverting a spectral Gram factor B with B*B=Q; taking Y=Q^(−1/2) is one valid choice. Its radius a/m agrees with the displayed one, since m=min(1,max(1,R₃)⁻¹). The family diag(u²,1) explains why an upper bound on the determinant accompanies the bound on Q⁻¹.",
      "dependencies": [],
      "equations": [
        "inputs-unfolding-scalar-determinant"
      ],
