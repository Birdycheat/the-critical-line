    {
      "id": "PSL-01",
      "chapter": "global",
      "anchor": "global-primitive-line-short-vector",
      "title": "One vector is short at every embedding of a Hermitian line",
      "hypotheses": "E is a CM field unramified at finite places over its real subfield with [E:ℚ]=2f. M is a full integral lattice in a totally positive definite Hermitian E-line with discriminant-module order n.",
      "statement": "Some nonzero vector x∈M satisfies σ(h(x,x))≤rd(E)n^(1/(2f)) for every σ. The ideal norm identity and the volume of a product of complex disks yield the uniform squared-length bound.",
      "equations": [
        "global-line-squared-radius"
      ],
