    {
      "id": "PSL-02",
      "chapter": "global",
      "anchor": "global-primitive-line-packing",
      "title": "Packing in the trace norm counts the primitive lines of fixed discriminant order",
      "hypotheses": "In the same setting, L is a full integral lattice in positive definite ambient rank k≥1. The rational lines considered have intersection-lattice discriminant order n≥1.",
      "statement": "At most (9rd(E))^(kf)n^(k/2) lines occur. Distinct integral vectors have trace distance at least √(2f), and the chosen representative has trace norm at most √(2fB). Substituting n=d² yields the uniform endpoint used in the row genus average.",
      "equations": [
        "global-line-count-from-packing"
      ],
      "dependencies": [
        "PSL-01"
      ],
