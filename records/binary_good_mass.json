    {
      "id": "BGM-02",
      "chapter": "lifts",
      "anchor": "lifts-binary-regular-residues",
      "title": "Counting the primitive fibres over an odd residue field",
      "statement": "For a nonzero residue a the number of solutions of the four-variable nonsingular quadratic equation differs from q³ by at most q. Counting only primitive vectors over a zero residue gives error at most q²+1. The primitive density is the count divided by q³, with error at most q⁻² on units.",
      "hypotheses": "Odd residue field of order q, integral symmetric matrix invertible on reduction, additive Haar volume one for the integer ring.",
      "dependencies": [
        "BGM-01"
      ],
      "equations": [],
