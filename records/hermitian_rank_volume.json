    {
      "id": "HRV-02",
      "chapter": "global",
      "anchor": "global-hermitian-rank-product",
      "title": "The ordered rank factors and their local Euler factors",
      "statement": "If a signature drops from (p,q) to (p₀,q₀) with p₀+q₀≥2 and both indices weakly decreasing, the gauge volume ratio is the product of the rank factors over p₀+q₀<M≤p+q. Each split prime supplies one reciprocal Euler factor through its two conjugate prime ideals.",
      "hypotheses": "Self-dual models of the same unramified CM field of the flag construction, with these signatures at every real place.",
      "dependencies": [
        "HRV-01",
        "AFF-04"
      ],
      "equations": [
        "global-hermitian-rank-euler"
      ],
