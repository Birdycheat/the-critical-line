  "claims": [
    {
      "id": "HRV-01",
      "chapter": "global",
      "anchor": "global-hermitian-rank-step",
      "title": "One unit vector relates two successive Hermitian volumes",
      "statement": "In Hermitian rank M≥3 the quotient of the two gauge-normalized volumes for a permitted sign and its orthogonal complement is (2ν_E)^{f(M−1/2)} times the unramified Euler product at M.",
      "hypotheses": "CM extension unramified at all finite places, self-dual lattice data of the flag construction, common real signature and at least one direction of the selected sign at each real place.",
      "dependencies": [
        "OVM-03",
        "HRV-03",
        "HUD-02"
      ],
      "equations": [
        "global-hermitian-mean-comparison"
      ],
