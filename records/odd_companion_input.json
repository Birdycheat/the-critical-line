  "claims": [
    {
      "id": "OCI-01",
      "chapter": "lifts",
      "anchor": "lifts-odd-companion-trace",
      "title": "Polynomial congruences of Hecke data produce an odd-dimensional semisimple companion",
      "hypotheses": "The geometric seed and congruence theorems hold for an odd positive rank, a fixed pair of split auxiliary places above ℓ lying over distinct primes of the maximal totally real subfield and the chosen unitary data. The rational power-sum operators give target values in one finite extension of ℚℓ. Every finite list of approximating systems has a dense common set of Frobenius tests.",
      "statement": "While the auxiliary pair stays fixed, a single continuous trace on the Galois group serves every chosen finite set of local tests. Imposing all finite matching conditions gives joint convergence of group coordinates and trace values. Polynomial approximation passes the rank identities to that trace. Multilinearity extends the alternating identity to the group algebra, and the nondegenerate trace quotient realizes a continuous semisimple representation of the prescribed rank.",
      "equations": [
        "lifts-odd-companion-approx"
      ],
      "dependencies": [
        "GGP-01",
        "GGP-02",
        "GGP-03",
        "OGA-04",
        "HPA-03",
        "HPA-04"
      ],
