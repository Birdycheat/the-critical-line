  "claims": [
    {
      "id": "OVL-01",
      "chapter": "inputs",
      "title": "A compact set permits finitely many arithmetic changes of coordinates",
      "anchor": "inputs-overlap-columns",
      "statement": "For every compact Q inside the positive cone, Γ(Q)={γ | some h∈Q has γ·h∈Q} is finite. In positive rank with Q nonempty, the number is at most the product of the sizes of N specified lattice ellipsoids.",
      "hypotheses": "The properness theorem holds for any number field and N≥0. For the product choose h₀∈Q, a uniform A with q_(h₀)≤A q_h on Q, and B_j bounding q_h(e_j) there.",
      "definitions": [
        "The action is q_(γ·h)(v)=q_h(γ⁻¹v).",
        "Positive q_h on the unit sphere and compactness of Q give the uniform comparison by a continuous ratio.",
        "At rank zero the matrix group is trivial. Empty Q has no incidences."
      ],
      "equations": [
        "inputs-overlap-column-count"
      ],
