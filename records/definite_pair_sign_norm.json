  "claims": [
    {
      "id": "DPN-01",
      "chapter": "lifts",
      "anchor": "lifts-definite-pair-sign-norm",
      "title": "Which changes of sign can be realized by a finite adelic norm?",
      "hypotheses": "A number field M has a nonidentity endomorphism inducing conjugation under every complex embedding. S is a conjugation-stable set of its embeddings. For the marked application the spectral generator has a separable minimal polynomial of odd degree over a CM field and constant nonzero rational absolute square at all embeddings. The chosen place has positive index one.",
      "statement": "A scalar in the fixed field, negative precisely on S, is a local norm at every finite place if and only if 4 divides |S|. An adelic unit away from any rational prime realizes the norm of this same scalar. Excluding a marked root and its conjugate in the distinguished fibres gives |S| = 2(n−1).",
      "equations": [
        "lifts-definite-pair-adelic-norm",
        "lifts-definite-pair-sign-parity"
      ],
