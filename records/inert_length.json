  "claims": [
    {
      "id": "ILT-01",
      "title": "The exact excess length and the two thresholds",
      "chapter": "lifts",
      "anchor": "lifts-inert-length",
      "statement": "For every unramified unitary cell with signed outer valuation a and middle block g of length h, use an integral fraction U,V,C for g with v(det C)=h. For each radical representative (r,b,c), put α=max(a,0), R=d(rC), S=d(c−r·CVgb) and t=max(0,R−α), where d is the least nonnegative denominator exponent. The full length is |a|+h+max(2t,S−2α). The ball through |a|+h+j is therefore defined by R≤α+floor(j/2) and S≤2α+j, for all integers j≥0.",
      "dependencies": [
        "ILT-02"
      ],
      "equations": [
        "lifts-inert-length-test"
      ],
