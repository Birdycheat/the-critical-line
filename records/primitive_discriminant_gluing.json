    {
      "id": "GPD-02",
      "chapter": "global",
      "anchor": "global-primitive-perpendicular-order",
      "title": "A perpendicular intersection has discriminant order at most nN₀",
      "hypotheses": "The first intersection has discriminant order n and the ambient lattice has discriminant order N₀.",
      "statement": "The shared gluing index divides n and Q∨/qL is an image of L∨/L. Their orders multiply to the order a of Q∨/Q, giving a≤nN₀. Equality occurs for a plane with Gram matrix diag(1,2).",
      "equations": [
        "global-primitive-perpendicular-product"
