    {
      "id": "GPD-03",
      "chapter": "global",
      "anchor": "global-primitive-gluing-generators",
      "title": "The perpendicular rank bounds both lists of gluing generators",
      "hypotheses": "In the same setup W has rank s. The row has a cyclic ambient discriminant module.",
