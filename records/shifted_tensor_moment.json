    {
      "id": "STM-02",
      "chapter": "normalization",
      "anchor": "normalization-shifted-formal-degree",
      "title": "Comparing formal degrees before and after a one-coordinate lowering",
      "hypotheses": "Both signs occur, both parameters are regular and the initial opposite-sign gap is ≥200m³. The two degrees are for the same Haar measure on the same group.",
      "statement": "The reciprocal shifted degree costs at most 2^(m−1)/dπ by counting affected unordered pairs. The ordered-pair bound used on the route is 2^(2m)/dπ ≤ X^m/dπ.",
      "definitions": [
        "The degree is a signature- and measure-dependent positive constant times the type A product ∏a<b |λa−λb|/(b−a).",
        "Each shifted gap in an affected pair is a positive integer. The original gap is at most its successor."
      ],
