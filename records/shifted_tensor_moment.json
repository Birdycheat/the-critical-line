  "claims": [
    {
      "id": "STM-01",
      "chapter": "normalization",
      "anchor": "normalization-shifted-tensor-projectors",
      "title": "Reading a smooth dual tensor by its shifted discrete-series summands",
      "hypotheses": "A signed unitary group U(p,q) with 1≤q≤p and a discrete-series representation π of dominant regular parameter λ with opposite-sign gaps ≥200m³.",
      "statement": "On the smooth tensor with the dual defining representation, regular one-coordinate lowerings index the shifted summands. Their projections sum to the identity and their coordinates realize the signed invariant form with a scalar on each summand.",
      "definitions": [
        "The tensor is a column of m smooth vectors, with action π(g) and matrix factor (g⁻¹)ᵗ.",
        "The Casimir coordinate is κs=λs+(m−1)/2. Multiplication by the spectral interpolation polynomial extracts the s-coordinate on this smooth decomposition."
      ],
      "dependencies": [],
      "equations": [
        "normalization-shifted-form-identity"
      ],
