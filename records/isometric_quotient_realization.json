  "claims": [
    {
      "id": "IQR-01",
      "chapter": "global",
      "anchor": "global-isometric-quotient-realization",
      "title": "Isometric frame realizations of arithmetic quotients and sublattices",
      "hypotheses": "A totally complex number field K equipped with a ring involution, an integer n ≥ 0, invertible frames X_w ∈ GL_n(ℂ) indexed by the complex places w of K with frame coordinates f_{X,w}(y) = X_w⁻¹ y_w ∈ ℂⁿ, a finitely generated 𝒪_K-submodule A ⊆ Kⁿ and an 𝒪_K-submodule S ⊆ A saturated in A under the Euclidean realization ρ_X with quotient rank m = rk_K(A) − rk_K(S), and a finitely generated 𝒪_K-submodule R ⊆ Kⁿ of K-rank j = rk_K(R).",
      "statement": "On the quotient side, there exist q ∈ M_{m×n}(K), invertible frames X′_w ∈ GL_m(ℂ), and matrices Q_w ∈ M_{m×n}(ℂ) at every complex place w such that q vanishes on S, has kernel K·S on K·A, and maps A onto a full 𝒪_K-lattice q(A) ⊆ K^m; Q_w Q_w* = 1_m, im(Q_w*) ⊆ U′_w = span_ℂ f_{X,w}(A), and u − Q_w* Q_w u ∈ U_w = span_ℂ f_{X,w}(S) for all u ∈ U′_w; (X′_w)⁻¹(qy)_w = Q_w f_{X,w}(y) for all y ∈ A; and for every nonzero 𝒪_K-sublattice N′ ⊆ q(A), N = A ∩ q⁻¹(N′) satisfies S ⊊ N ⊆ A, q(N) = N′, and equal normalized quotient size relative to (X, S) and size in X′. On the sublattice side, there exist i ∈ M_{n×j}(K), invertible frames X″_w ∈ GL_j(ℂ), isometric matrices P_w ∈ M_{n×j}(ℂ) with P_w* P_w = 1_j, and a full finitely generated 𝒪_K-lattice B ⊆ K^j mapped bijectively onto R by i such that X_w⁻¹ i_w = P_w(X″_w)⁻¹ at every complex place w and the largest normalized quotient size of B in X″ equals that of R in X.",
      "definitions": [
        "orthogonal complement subspace C_w = U_w⊥ ∩ U′_w and partial coisometry Q_w",
        "intertwining quotient frame X′_w = q_w X_w Q_w* ∈ GL_m(ℂ)",
        "positive-definite Hermitian Gram square root S_w = (Y_w* Y_w)^{1/2}",
        "polar column isometry P_w = Y_w S_w⁻¹ and sublattice frame X″_w = S_w⁻¹"
      ],
