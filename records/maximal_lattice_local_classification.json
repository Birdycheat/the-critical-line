    {
      "id": "MHC-03",
      "chapter": "global",
      "anchor": "global-maximal-primitive-line",
      "title": "Fixing the primitive auxiliary vector identifies the original lattices",
      "hypotheses": "Two maximal integral lattices in the same nondegenerate space over the stipulated unramified CM field, at any one finite place. In the inert correction the auxiliary vector has nonunit norm π and admits a pairing witness one.",
      "statement": "Correcting the comparison of the two unimodular extensions by an integral isometry of the target fixes the auxiliary vector. Restriction identifies the localized maximal lattices, proving they lie in one genus.",
      "equations": [
        "global-maximal-integral-symmetry"
      ],
