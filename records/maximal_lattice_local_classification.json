    {
      "id": "MHC-01",
      "chapter": "global",
      "anchor": "global-maximal-local-defect",
      "title": "The ambient determinant detects the single possible residue defect",
      "hypotheses": "A finite-dimensional nondegenerate Hermitian space over a CM field unramified at finite places over its real subfield and a maximal integral full lattice.",
      "statement": "At a split place a maximal lattice is self-dual. At an inert place its defect is zero or has length one and order q². The latter occurs exactly when the local Gram determinant has odd valuation.",
      "equations": [
        "global-maximal-defect-line"
      ],
