  "claims": [
    {
      "id": "SAA-01",
      "chapter": "inputs",
      "anchor": "inputs-stickelberger-annihilator",
      "title": "The integral operator obtained from opposite residues",
      "statement": "For a cyclotomic field of conductor parameter M and odd c coprime to M, the centered half-sum θ obeys θ(1−J)=[c e_c−(k+1)−kJ]ϑ with integral coefficients g(t), where k=(c−1)/2, e_t=σ_t⁻¹ and ϑ is the rational Stickelberger element.",
      "hypotheses": "M>2, c positive and odd, gcd(c,M)=1. Each residue and its negative occur once as an unordered pair.",
      "correspondence": "The coefficient proof uses Euclidean division after multiplication by c⁻¹. The degree-one representative does not enter the group-ring identity.",
      "dependencies": [],
      "equations": [
        "inputs-stickelberger-integral-operator"
      ],
