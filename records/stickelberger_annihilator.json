    {
      "id": "SAA-03",
      "chapter": "inputs",
      "anchor": "inputs-stickelberger-class-action",
      "title": "From integral annihilation to a nilpotent action on the class quotient",
      "statement": "Let C=Cl(Q(ζ_M)) and E=(1−J)C. Then θE=0. Whenever (γ−1)^N belongs to (θ,1+J,ℓ), it sends E into ℓE, so its action on E/ℓE is zero.",
      "hypotheses": "For the uniform cyclotomic application, M=fℓⁿ, f>1 coprime to the prime ℓ, c=2fℓ+1 and n sufficiently large. The exponent is independent of n.",
      "correspondence": "The integral annihilation statement concerns the action on ideal classes, and the nonzero coefficient at a finite projection supplies the uniform group-ring membership. The image of 1−J works integrally at 2.",
      "dependencies": [
        "SAA-02",
        "STP-03"
      ],
