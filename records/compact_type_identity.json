  "claims": [
    {
      "id": "CTI-01",
      "chapter": "normalization",
      "anchor": "normalization-compact-type-jets",
      "title": "A gap between opposite signs forces uniqueness of all compact-type Taylor coefficients",
      "statement": "For the finite-dimensional lowest K-type S of a signed-unitary discrete series, two smooth compact-biequivariant compressions agreeing at the identity and satisfying the same lowering equations near the identity have identical Lie derivatives there in all orders, whenever the opposite-sign parameter differences admit a common lower bound γ>2m.",
      "hypotheses": "The common S is generated by a highest-weight unit vector, in a unitary discrete series with decreasing integral-shifted parameter λ. The lowering equations are imposed for every first-order array in the sum of compact constituents of weights Λ+e_a−e_b with b<a and opposite signs. The group acts on the input and output by the same compact type.",
      "dependencies": [
        "MSC-03"
      ],
      "equations": [
        "normalization-compact-type-lowering",
        "normalization-compact-type-gap"
      ],
