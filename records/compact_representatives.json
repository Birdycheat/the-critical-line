  "claims": [
    {
      "id": "FCR-01",
      "chapter": "inputs",
      "title": "Squared column bounds and the real Gram determinant bound the norm of a frame",
      "anchor": "inputs-compact-determinant",
      "statement": "Write d=N[L:ℚ] and r=[L:ℚ]/2. A nonsingular integral frame A with every column of squared length at most D satisfies 1≤|Norm(det A)|≤I₀(D/c)^(Nr), where I₀=|disc L|^N d^d.",
      "hypotheses": "L is totally complex, N≥1, h is positive definite at all complex places and c,D>0. The lower squared bound c holds on every nonzero integral vector. The upper inequality itself holds for arbitrary integral A satisfying the column bounds; the lower bound 1 uses det A≠0.",
      "definitions": [
        "P(h)=∏_w det h_w uses one representative of each complex place.",
        "The real Gram matrix in integral coordinates of k=h/c has dimension d.",
        "The combined conjugate embeddings give 2^d det G=|disc L|^N P(k)^2."
      ],
      "equations": [
        "inputs-compact-norm-bound"
      ],
      "dependencies": [
        "LTR-01"
      ],
