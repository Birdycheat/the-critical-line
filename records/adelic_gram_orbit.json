    {
      "id": "AGF-02",
      "chapter": "lifts",
      "anchor": "lifts-adelic-gram-inverse",
      "title": "Adelic inverses of the column corrections",
      "statement": "At each column, a choice among four norm-one phases gives a denominator with nonzero norm at every place and an integral unit norm at almost every finite place. The resulting corrections and their inverses have adelic entries.",
      "hypotheses": "Diagonal column lengths are nonzero base-field elements. The two tuples have the same regular Gram matrix. The quadratic coefficient algebra at a split place has two factors.",
      "dependencies": [
        "AGF-01",
        "GPL-02"
      ],
      "equations": [],
