    {
      "id": "AGF-01",
      "chapter": "lifts",
      "anchor": "lifts-rational-gram-basis",
      "title": "One rational diagonal change for all completions",
      "statement": "A rational change S of the n columns turns their regular Hermitian Gram matrix into a diagonal matrix with entries in F×. The same change on a target tuple with equal Gram matrix reduces the lifting equation to orthogonal columns of prescribed nonzero lengths.",
      "hypotheses": "A CM extension E/F, a nonsingular Hermitian ambient form, and an E-rational tuple with nonsingular Gram matrix. The target is an adelic tuple with that same Gram matrix.",
      "dependencies": [],
      "equations": [
        "lifts-rational-gram-congruence"
      ],
