  "claims": [
    {
      "id": "HUD-01",
      "chapter": "global",
      "anchor": "global-hermitian-unit-density",
      "title": "Counting a unit norm in a self-dual Hermitian lattice",
      "statement": "With lattice and scalar integers each of volume one, any unit target β has density 1−η^M Q^(−M). The count for a nonzero residue is B=Q^(2M−1)−η^M Q^(M−1). The count per target increases by Q^(2M−1) at each further digit, including above 2.",
      "hypotheses": "Complete base DVR of characteristic zero and finite residue field of size Q; unramified quadratic field or split étale algebra; unimodular Hermitian lattice of rank M≥1; β a unit.",
      "definitions": [
        "η=+1 in the split algebra and −1 in the inert field. Z_M counts all vectors of norm zero modulo π."
      ],
      "dependencies": [],
      "equations": [
        "global-hermitian-unit-count"
      ],
