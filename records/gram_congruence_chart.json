  "claims": [
    {
      "id": "GCC-01",
      "chapter": "lifts",
      "anchor": "lifts-gram-congruence-chart",
      "title": "Nonzero pivots give local triangular coordinates on Hermitian matrices",
      "statement": "Over a completion R of the totally real base F of a CM extension E, write K=R⊗_F E with its standard involution. A nonsingular centre S has S=b*Db with diagonal D in (R×)^n. At D the repeated Schur complement gives continuous inverse coordinates on an open neighborhood for N*diag(p_i)N with N upper unitriangular.",
      "hypotheses": "The field completion has characteristic zero. The finite étale quadratic algebra K may be split. Each pivot is nonzero in R. No prescribed basis is assumed to start with a nonzero leading pivot.",
      "correspondence": "The source proves the diagonalization for its more general reduced Artinian base, then implements the continuous pivot shear and rank induction. The field case in this passage proves existence of a nonzero length using polarization.",
      "dependencies": [],
      "equations": [
        "lifts-gram-congruence-pivot"
      ],
