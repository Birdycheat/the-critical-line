    {
      "id": "DML-02",
      "chapter": "global",
      "anchor": "global-discriminant-order-mass",
      "title": "The mass of lattices with specified discriminant order",
      "hypotheses": "The same definite space and local hypotheses, with the standard orthonormal genus of the same rank as reference.",
      "statement": "The sum of reciprocal stabilizer orders for discriminant order n is at most the standard genus mass times n^((r+log₂[E:ℚ])/2). The middle-rank primitive count uses this separately for each nonzero complementary rank.",
