  "claims": [
    {
      "id": "DML-01",
      "chapter": "global",
      "anchor": "global-marked-maximal-lattices",
      "title": "Marking a maximal enlargement bounds the fibre by a fixed index count",
      "hypotheses": "A positive definite integral Hermitian lattice of rank r≥1, a CM field E unramified at the finite places of its real subfield and fixed positive discriminant order n.",
      "statement": "Every nonempty discriminant-order family has maximal enlargements in one genus. Each index i is fixed by n=n₀i². Marking an enlargement bounds its weighted mass by the maximal genus mass times i^(r+log₂[E:ℚ]).",
      "equations": [
        "global-discriminant-index-square"
      ],
