    {
      "id": "CYC-01",
      "title": "A closed cyclic word in degree twice the twist",
      "chapter": "inputs",
      "anchor": "inputs-cyclic-filling",
      "equations": [
        "inputs-cyclic-word"
      ],
      "dependencies": [],
      "statement": "In the bar chains of C=ℤ/q with ℤ/q coefficients, the sum of words [j₁|1|…|jₑ|1] over all e-tuples is a cycle in degree 2e.",
      "hypotheses": "q>0 and e≥1. The application has q=ℓ^ν. Each group entry is written additively. Lean uses zc q (e−1).",
      "definitions": [
        "bar chain",
        "boundary",
        "cyclic group"
      ],
      "correspondence": "The dropped initial entry sums to q copies of a word. Successive contractions agree after shifting one or two summation indices and have opposite signs.",
