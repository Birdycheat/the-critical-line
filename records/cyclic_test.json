    {
      "id": "CYC-03",
      "title": "The scalar residue functional and its prism value",
      "chapter": "inputs",
      "anchor": "inputs-residue-prism",
      "equations": [
        "inputs-residue-carry"
      ],
      "dependencies": [
        "CYC-01"
      ],
      "statement": "On k× the degree-(2e+1) cocycle built from e logarithmic carries and v takes the prism of the weight-x cyclic word and g to xᵉv(g) in ℤ/q.",
      "hypotheses": "k a finite field, ζ∈k× of order q>0, e≥1, x a natural number, v:k×→ℤ/q an additive index and g∈k×. The construction works for any such homomorphism v.",
      "definitions": [
        "normalized logarithm",
        "carry",
        "bar cocycle",
        "scalar prism"
      ],
      "correspondence": "The logarithm has a prescribed residue at ζ and its integer carry satisfies the cocycle identity. Cyclic shifts telescope to x. Symmetric carries cancel neighboring prism insertions, leaving e independent factors and the index of the gluing element.",
