  "claims": [
    {
      "id": "FDG-01",
      "chapter": "global",
      "title": "Fixing the Haar-normalized degree by two limits",
      "anchor": "global-formal-constant",
      "statement": "On the CD Haar measure the formal degree of a mixed-signature large-gap discrete series is V(λ)/F_N, where F_N=0!1!⋯(N−1)!. Translation makes d/V constant on an admissible ray. The lowest-compact-type Weyl formula and a Gaussian coefficient limit determine that constant.",
      "hypotheses": "N=p+q, p,q≥1, ε assigns signs to the ordered indices, λ is strictly decreasing and λ_i−(N−1)/2 is integral, all opposite-sign differences are at least h and the chamber threshold for ε+1<h. Fix a discrete series σ of this parameter and a nonzero coefficient vector. The Haar tie identifies μ_CD with the row scale. The compatible discrete-series models exist throughout the ray.",
      "definitions": [
        "Harish-Chandra parameter",
        "discrete series",
        "formal degree",
        "CD Haar measure",
        "lowest compact type",
        "Vandermonde product",
        "opposite-sign pair"
      ],
      "equations": [
        "global-formal-identity",
        "global-formal-limits"
      ],
