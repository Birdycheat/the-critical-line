  "claims": [
    {
      "id": "CRD-01",
      "title": "A two-coordinate competitor from simultaneous approximation",
      "chapter": "inputs",
      "anchor": "inputs-cusp-reduction",
      "statement": "For each number field L there is C≥1 such that every adelic upper triangular two-by-two block with invertible diagonal α,β has a nonzero L-rational row whose image has adelic height at most C√(|α|𝔸|β|𝔸).",
      "hypotheses": "Both diagonal entries are idèles, the upper right entry is any adèle, the archimedean norms have multiplicities 1 or 2 and finite vector norms are supremum norms.",
      "definitions": [
        "the box in the mixed archimedean lattice",
        "normalized positive idèle",
        "the scaling s=(|α/β|𝔸)^(1/(2d)) with d=[L:ℚ]"
      ],
