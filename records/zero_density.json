      "chapter": "inputs",
      "anchor": "inputs-zero-detector",
      "title": "A zero forces a large block of the mollified polynomial",
      "statement": "Take Q≥20 and a primitive nonprincipal character of conductor q≤Q. If L(ρ,χ)=0 with Re ρ>399/400 and |Im ρ|≤Q, some block Y·2^j<n≤2Y·2^j has |Σ a(n)χ(n)n^(−ρ)|≥1/(2J), for 0≤j<J.",
      "hypotheses": [
        "X=⌈Q⌉, Y=X⁴, J=8(⌊log₂X⌋+1), N=2^J.",
        "a(n) sums μ(d) over all n=db with positive d≤Y, b≤N."
      ],
