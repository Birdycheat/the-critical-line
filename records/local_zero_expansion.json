  "claims": [
    {
      "id": "LZE-01",
      "chapter": "inputs",
      "anchor": "inputs-local-zero-factorization",
      "title": "Counting zeros and subtracting their logarithmic poles on a disk",
      "statement": "For a function bounded on radius r by B times its nonzero centre value, the number of zeros on radius r/3 counted with order is at most log B/log 2. Subtracting all their logarithmic poles leaves an analytic remainder of absolute value at most 72 log B/r on radius r/6.",
      "hypotheses": "Positive radius, B≥1, a holomorphic function on a neighbourhood of the closed disk and a nonzero value at the centre. Pointwise subtraction uses evaluation away from zeros and the remainder extends across them.",
