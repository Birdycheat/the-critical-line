  "claims": [
    {
      "id": "HTF-01",
      "chapter": "inputs",
      "title": "Recognizing inherited Hecke cosets by a residue line",
      "anchor": "inputs-hecke-transfer",
      "statement": "The right cosets of S_N=Γ_N∩q⁻¹Γ_N q are indexed injectively by the line of c⁻¹e₁ modulo π. A line belonging to a coset comes from size n exactly when its last r coordinates vanish. The index is finite and at least N.",
      "hypotheses": [
        "The totally complex arithmetic field and positive degree m<r₂ of the stable period comparison. For the coset counts alone use a principal prime (π), sizes n≥1 and N=n+r with r≥1. The stabilizer comparison uses the arithmetic affine-block homology and evaluation hypotheses in pKey."
      ],
      "equations": [
        "inputs-hecke-transfer-share"
      ],
