  "claims": [
    {
      "id": "PTD-01",
      "chapter": "inputs",
      "anchor": "inputs-local-finiteness",
      "title": "Local Galois cohomology finiteness and cohomological dimension two over local fields",
      "hypotheses": "A nonarchimedean local field K with separable closure K^{sep} and absolute Galois group G_K = Gal(K^{sep}/K), and a finite discrete G_K-module M whose cardinality |M| is nonzero in K (automatically satisfied whenever char(K) = 0, in particular for every finite extension K of ℚ_ℓ and every finite discrete ℤ/ℓ^rℤ-module M, even when |M| is a power of the residue characteristic ℓ).",
      "statement": "For every degree t ≥ 0, both the local Galois cohomology group H^t(G_K, M) and the cohomology group H^t(G_K, M^*) of the Cartier dual M^* = Hom(M, (K^{sep})^×) are finite, and H^t(G_K, M) = 0 for all t ≥ 3. In particular, for every prime ℓ, every finite extension K of ℚ_ℓ inside ℚ̄_ℓ, every r ≥ 1, and every continuous finite discrete ℤ/ℓ^rℤ-representation M of G_K, the groups H^0(G_K, M), H^1(G_K, M), and H^2(G_K, M) are finite and H^n(G_K, M) vanishes for all n ≥ 3.",
      "definitions": [
        "finite discrete Galois module M over a nonarchimedean local field K with |M| invertible in K",
        "Cartier dual M^* = Hom(M, (K^{sep})^×) with conjugate Galois action (g · f)(m) = g(f(g^{−1} · m))",
        "local cohomological dimension bound H^t(G_K, M) = 0 for all t ≥ 3"
      ],
      "equations": [
        "inputs-local-finiteness-eq"
      ],
