    {
      "id": "MPS-01",
      "chapter": "lifts",
      "anchor": "lifts-marked-period-fibre-isometry",
      "title": "The marked lattice class of a polarized complex fibre",
      "hypotheses": "Two period descriptions of the same complex abelian fibre with its order action, relatively ample line bundle and level sections killed by N > 0. Their period lattices are full and have the prescribed Weil pairing at all positive division levels.",
      "statement": "The identity lifts to an invertible complex-linear map U and an order-linear isometry w of the integral lattices, with P′w = UP, e′U = e and wt(a) ≡ t′(a) modulo NL′. Conversely a marked isometry transports a description to the same fibre.",
      "equations": [
        "lifts-marked-period-weil-sign"
      ],
