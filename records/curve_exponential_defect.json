      "id": "CED-01",
      "chapter": "normalization",
      "anchor": "normalization-curve-negation-congruence",
      "title": "Congruence of the Weierstrass correcting series under formal negation",
      "hypotheses": "A characteristic-zero field K, a subring R⊆K containing the Weierstrass coefficients of W and 1/2, and an arbitrary scalar s₂∈K.",
      "statement": "For the correcting series φ(T) satisfying σ*(l(T))=T exp(−φ(T)) with φ(0)=0, composition with formal negation [−1]_l(T) satisfies q_{−1}(T)=φ([−1]_l(T))≡φ(T), meaning that exp(q_{−1}−φ) has all coefficients in R.",
      "definitions": [
        "normalized formal sigma series σ*(z)",
        "Weierstrass correcting series φ(T)",
        "subgroup of zero-constant series with integral exponential",
