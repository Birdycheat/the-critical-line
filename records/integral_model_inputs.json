  "claims": [
    {
      "id": "IMI-01",
      "chapter": "lifts",
      "anchor": "lifts-isogeny-dvr-target",
      "title": "A polarized isogeny out of an integral marked object has an integral target",
      "hypotheses": "V is a discrete valuation ring with fraction field K, of any residue characteristic. o is a marked object of the unitary moduli problem over V, and ψ_K : o_K → o′ is a polarized isogeny of multiplier c = q^e with a companion ψ′ satisfying ψ′ψ = [c] and ψψ′ = [c].",
      "statement": "o′ is the generic fibre of a marked object over V, namely the quotient of A by the schematic closure of ker ψ_K with the extended marking, and ψ_K extends. Consequently a tested point y ∈ X(V) with generic point s₀(x) has a target z ∈ X(V) with generic point t₀(x), and the reverse statement holds after rescaling the level of the companion by q^f with q^{e+f} ≡ 1 mod N.",
      "definitions": [
        "The schematic closure of the generic kernel is finite and flat because it is killed by c.",
        "The rescaled target object replaces the level structure η′ by η′∘[q^f]."
      ],
