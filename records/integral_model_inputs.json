    {
      "id": "IMI-02",
      "chapter": "lifts",
      "anchor": "lifts-isogeny-finite-specializations",
      "title": "Finitely many target specializations in both directions",
      "hypotheses": "The elementary correspondence has finite étale projections over X[1/q]. Its multiplier is c=q^e, with a compatible companion, N ≥ 3 prime to q and PEL multiplicity one. Over characteristic q the chosen quadratic polynomial splits with distinct roots and the embedding characters have distinct residue kernels.",
      "statement": "For each point u of X, the images in X of the closed points of DVR tests extending the generic target and starting at u form a finite set. The reverse set of endpoints is finite with the original target fixed.",
      "definitions": [
        "A valuative test is a discrete valuation ring V with a point x of Y₀ over its fraction field and V-points extending s₀(x) and t₀(x).",
        "The endpoint is the image in X of the closed point of Spec V.",
        "For the reverse finiteness test the fixed target B becomes the source of the companion B → S_e A."
      ],
      "equations": [],
      "dependencies": [
        "IMI-01"
      ],
