  "claims": [
    {
      "id": "IOR-01",
      "chapter": "inputs",
      "title": "The closed dyadic decomposition image has index at most two or four",
      "anchor": "inputs-inertia-depth",
      "equations": [],
      "statement": "Let A be a prolongation to Ω of the rational prime p. In the absolute Galois group G of ℚ, K=ker χ₂, the subgroup K D_A has finite index at most 2 if p≡3 mod 8 and at most 4 if p≡7 mod 16.",
      "hypotheses": "Ω an algebraic closure of ℚ, p a rational prime in the indicated class. The auxiliary abelian field does not enter this assertion.",
      "definitions": [
        "D_A is the decomposition group and H=χ₂(D_A) is a closed subgroup of ℤ₂^×.",
        "A single arithmetic Frobenius acts as x↦x^p on all roots of order coprime to p; taking all dyadic roots gives p∈H.",
        "P_a=1+2^aℤ₂, a=v₂(p²−1) equals 3 or 4, and p∉P_a."
      ],
