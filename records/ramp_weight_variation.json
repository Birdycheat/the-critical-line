  "claims": [
    {
      "id": "RWV-01",
      "chapter": "balance",
      "anchor": "balance-ramp-weight-variation",
      "title": "Uniform variation of a centered ramp as its weight moves",
      "statement": "For positive amplitude a and positive weights w and w′, the difference of wGψ(a/w) and w′Gψ(a/w′) has absolute value at most 3a|w−w′|/min(w,w′), uniformly over all local characters, including the trivial character.",
      "hypotheses": "The finite-group coefficient is a unit-character average of absolute value at most one at prime powers. The trivial character uses the centered zeta ramp. The prime-power sum Ψ(y) is bounded by 3y for y≥0.",
      "dependencies": [
        "PIL-01",
        "PIL-04",
        "PIL-05"
      ],
      "equations": [
        "balance-ramp-weight-bound"
      ],
