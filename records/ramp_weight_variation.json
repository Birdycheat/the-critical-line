    {
      "id": "RWV-02",
      "chapter": "balance",
      "anchor": "balance-ramp-weight-cost",
      "title": "The cost of substituting the reference weight at thick positions",
      "statement": "If b≤w≤b+η+1 and |a/b−x|≤1 at a thick position, substituting b costs at most 3(x+1)(η+1) per character. With the local cost constraints, replacing the thick weights and omitting the thin terms together cost at most 2b/x per measurement.",
      "hypotheses": "x≥3, b>0, η≥0. There are f=|Φ| positions and 2f characters, and the character expansion divides by f. The thick budget is 6f(x+1)(η+1)≤b/x. The separate thin allowance is at most b/x.",
      "dependencies": [
        "RWV-01",
        "BAL-01"
      ],
      "equations": [
        "balance-ramp-thick-cost"
      ],
