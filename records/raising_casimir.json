  "claims": [
    {
      "id": "MSC-01",
      "chapter": "normalization",
      "anchor": "normalization-one-slot-types",
      "title": "The raising and lowering parts in one noncompact derivative",
      "statement": "For an irreducible compact type S of highest weight Λ and one complexified noncompact direction, the occurring highest weights in 𝔭ℂ⊗S are of the form Λ+e_a−e_b with opposite signs. The isotypic sums for a<b and b<a give an orthogonal decomposition.",
      "hypotheses": "K=U(p)×U(s), signs kept in the decreasing Harish-Chandra parameter order, S finite dimensional and unitary. The group acts on 𝔭ℂ by conjugation and on the coefficients in S by its given representation.",
      "correspondence": "The proof takes a nonzero array coefficient with maximal index difference. Its diagonal weight is shifted back by the row-minus-column root and all its putative correction terms for compact raising operators have larger difference, hence vanish. Compact highest-weight uniqueness and orthogonal isotypic splitting give the result. Candidate labels need not all occur.",
      "dependencies": [],
      "equations": [
        "normalization-one-slot-action"
      ],
