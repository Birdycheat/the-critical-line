    {
      "id": "PXL-01",
      "chapter": "global",
      "anchor": "global-point-finite-span",
      "title": "The rational intersection recovers the full finite adelic lattice",
      "hypotheses": "E/F is a CM extension of number fields. L is a finitely generated full lattice in Eⁿ. The finite component is invertible over E tensored with the finite adeles of F.",
      "statement": "For M the translate of the integral adelic span of L, Λₓ = Eⁿ ∩ M is a full finitely generated lattice, and its span over the integral tensor ring is exactly M.",
      "equations": [
        "global-point-adelic-intersection"
      ],
