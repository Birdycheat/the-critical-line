  "claims": [
    {
      "id": "DIP-01",
      "title": "Projecting integer weights onto one selected slope",
      "chapter": "inputs",
      "anchor": "inputs-determinant-interpolation",
      "equations": [
        "inputs-determinant-projections"
      ],
      "dependencies": [
        "CYC-02"
      ],
      "statement": "There is an integer-valued multiplicity function on (ℤ/q)² whose projections along all m other slopes vanish and whose projection at t₀ is Σᵢ pᵢ[κⁱ], where pᵢ are the integer coefficients of P(T)=∏_{j<m}(T−κʲ).",
      "hypotheses": "q=ℓ^ν, ℓ prime, c≤ν, m=2e+1<ℓ^c, e≥1, κ=1+ℓ^c and t₀ among 0,…,m. The application has a unit coefficient at t₀. The weights are integers and the labels are residues.",
      "definitions": [
        "integer group algebra",
        "fiber sum",
        "substitution on polynomials"
      ],
      "correspondence": "The polynomial substitution raises the multiplicity of X^(ℓ^c)−1 at each stage after subtraction of the corresponding scalar. Replacing X by the point mass [1] lets the product of the m differences at t₀ divide the target. All other projections contain a zero factor.",
