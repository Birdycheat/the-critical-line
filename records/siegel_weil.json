  "claims": [
    {
      "id": "SWF-01",
      "chapter": "lifts",
      "title": "Siegel–Weil supplies an integrable theta kernel and an Eisenstein value",
      "anchor": "lifts-siegel-weil",
      "statement": "For every doubled group argument, the target theta kernel is integrable and its normalized mean is the holomorphic value at s₀=(b−a)/2 of the flat Eisenstein family. For b>2a this is an actual convergent series value; for a<b≤2a the convergent-range theorem supplies the continued value.",
      "hypotheses": "Hermitian spaces from the chain with source rank 1≤a<b, w the Witt index of B and w=0 or a+w<b. Use the compatible Weil datum (1,χ_B), Cartan involutions and compact subgroup, the self-dual frame Iwasawa data, the covolume-one measure for the Weyl datum, target Haar measure, and a Fock vector.",
      "equations": [
        "lifts-siegel-weil-mean"
      ],
      "dependencies": [
        "SWF-02",
        "SWF-03",
        "SCF-03"
      ],
