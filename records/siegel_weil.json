    {
      "id": "SWF-02",
      "chapter": "lifts",
      "title": "Parabolic equivariance and the parameter of the flat Siegel section",
      "anchor": "lifts-siegel-weil-section",
      "statement": "At the reference point s₀, the section transforms on a Levi block M by χ_B⁻¹(det M)|det M|^(b/2) and is invariant under its unipotent radical. The compact translates span a finite-dimensional space, and the flat deformation multiplies the reference section by h(g)^(s−s₀).",
      "hypotheses": "A valid Weil datum and theta vector, with Haar measure and fundamental region of covolume one on the rational lattice and compact-finite vector for the finite-dimensional claim. The standard chart preserves the rational groups and translates the compact subgroup.",
      "equations": [
        "lifts-siegel-weil-mean"
      ],
