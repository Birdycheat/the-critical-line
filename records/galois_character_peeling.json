  "claims": [
    {
      "id": "GCP-01",
      "chapter": "lifts",
      "anchor": "lifts-galois-character-transfer",
      "title": "A single simultaneous intertwiner transfers the prescribed character into the first lift",
      "hypotheses": "Two semisimple representations and two lists of rank-one characters over an algebraically closed field of characteristic zero. In the Galois application all objects are continuous, the two lifted Satake multisets have a common part and the chosen split primes have dense inverse Frobenius classes outside every finite set.",
      "statement": "The augmented direct sums are isomorphic as group representations. A character on the first list gives a common eigenvector in the first lift whenever it differs as a global character from every character on the second list.",
      "equations": [
        "lifts-galois-character-augmented",
        "lifts-galois-character-projection"
      ],
      "dependencies": [
        "LFT-05",
        "GGP-04"
      ],
