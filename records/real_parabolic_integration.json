  "claims": [
    {
      "id": "RPI-01",
      "chapter": "global",
      "anchor": "global-real-parabolic-integration",
      "title": "The inverse conjugation determinant in real parabolic integration",
      "statement": "For G = U(p,q) and the stabilizer NM of an isotropic flag, the NMK integration density is the inverse of the real determinant of conjugation on Lie(N). For local sizes s it equals the one-place flag weight P₁(s).",
      "hypotheses": "A totally isotropic flag with positive rank jumps in signature (p,q), the Hilbert–Schmidt subgroup gauges, compact Haar probability, and a nonnegative measurable integrand. The ambient Haar measure is multiplied by its small-ball gauge correction.",
      "dependencies": [
        "FSV-01",
        "PGU-01"
      ],
