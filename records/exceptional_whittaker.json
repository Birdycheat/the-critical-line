  "claims": [
    {
      "id": "EWH-01",
      "chapter": "lifts",
      "title": "Shell cancellation gives an entire exceptional finite factor",
      "anchor": "lifts-exceptional-whittaker",
      "statement": "For a full-rank Hermitian target, the integrals of r(b)^{−(z−s₀)}u(b) over sufficiently large concentric balls agree for all complex z. A single compact integral defines an entire function. On a sufficiently far right half-plane the full integral is absolutely convergent and equals this function.",
      "hypotheses": "Finite place v of a CM extension E/F, locally nontrivial component of the adelic character, nondegenerate source J, locally constant compactly supported complex Φ and det T a unit of E⊗Fᵥ. Source and target measures are self-dual and L₁,L₂ are compact open additive subgroups measured by Haar λ. LocFinX also accepts a continuous Gram density. Its local statement allows every pair of ranks.",
      "equations": [
        "lifts-exceptional-integral"
      ],
